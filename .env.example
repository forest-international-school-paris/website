# PostHog analytics — get these from https://app.posthog.com (Project Settings)
# The project API key is a PUBLIC client-side key; safe to expose in the browser.
PUBLIC_POSTHOG_KEY=phc_your_project_api_key_here

# Region host. Use EU cloud (default) for GDPR since the school is in France.
#   EU:  https://eu.i.posthog.com
#   US:  https://us.i.posthog.com
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
