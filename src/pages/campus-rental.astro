---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Campus Rental — Forest International School Paris" description="Rent a unique nature-inspired venue in the heart of Paris. Perfect for workshops, retreats, parties, filming, and corporate events.">
  <!-- Hero Section -->
  <section class="relative py-24 lg:py-36 overflow-hidden">
    <div class="absolute inset-0">
      <img src="/images/campus.jpg" alt="Forest International School Campus" class="w-full h-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-r from-[#1e3d29]/95 via-[#2d5a3d]/85 to-[#2d5a3d]/40"></div>
    </div>
    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <span class="inline-flex items-center gap-2 px-4 py-2 bg-[#c9a962]/20 backdrop-blur-sm rounded-full text-[#c9a962] font-semibold text-sm mb-6 border border-[#c9a962]/40">
          <span>🌿</span> Exclusive Venue Hire in Paris
        </span>
        <h1 class="text-4xl md:text-5xl lg:text-7xl font-bold text-white mb-6 leading-tight">
          Paris's Best<br/>
          <span class="text-[#c9a962]">Hidden Gem</span>
        </h1>
        <p class="text-xl md:text-2xl text-white/90 leading-relaxed mb-8">
          A rare blend of greenery and character, available for private hire when school is out.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/contact" class="inline-flex items-center justify-center px-8 py-4 bg-[#c9a962] text-white font-bold rounded-full hover:bg-[#b8963d] transition-all shadow-xl hover:shadow-2xl hover:-translate-y-0.5">
            Request Availability
            <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
          <a href="#spaces" class="inline-flex items-center justify-center px-8 py-4 bg-white/10 backdrop-blur-sm border-2 border-white/30 text-white font-bold rounded-full hover:bg-white/20 transition-all">
            Explore Spaces
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Highlights Bar -->
  <section class="bg-[#1e3d29] py-8">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center text-white">
        <div>
          <div class="text-3xl md:text-4xl font-bold text-[#c9a962] mb-1">500m²</div>
          <div class="text-sm uppercase tracking-wider text-white/70">Indoor + Outdoor</div>
        </div>
        <div>
          <div class="text-3xl md:text-4xl font-bold text-[#c9a962] mb-1">120+</div>
          <div class="text-sm uppercase tracking-wider text-white/70">Guests Capacity</div>
        </div>
        <div>
          <div class="text-3xl md:text-4xl font-bold text-[#c9a962] mb-1">16ᵉ</div>
          <div class="text-sm uppercase tracking-wider text-white/70">Arrondissement</div>
        </div>
        <div>
          <div class="text-3xl md:text-4xl font-bold text-[#c9a962] mb-1">7/7</div>
          <div class="text-sm uppercase tracking-wider text-white/70">Out of School Hours</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Perfect For Section -->
  <section class="py-20 lg:py-28 bg-[#faf8f5]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <span class="inline-block px-4 py-2 bg-[#2d5a3d]/10 rounded-full text-[#2d5a3d] font-semibold text-sm mb-4">Perfect For</span>
        <h2 class="text-3xl md:text-5xl font-bold text-[#1e3d29] mb-4">A Venue Like No Other</h2>
        <p class="text-gray-600 text-lg max-w-2xl mx-auto">
          Whatever you're planning, our campus offers a unique atmosphere your guests will remember.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="group bg-white rounded-2xl p-8 shadow-sm hover:shadow-xl transition-all hover:-translate-y-1">
          <div class="text-4xl mb-4">🎂</div>
          <h3 class="text-xl font-bold text-[#1e3d29] mb-2">Birthday Parties</h3>
          <p class="text-gray-600 text-sm leading-relaxed">Magical kids' parties with garden games, indoor space, and a swimming pool option.</p>
        </div>

        <div class="group bg-white rounded-2xl p-8 shadow-sm hover:shadow-xl transition-all hover:-translate-y-1">
          <div class="text-4xl mb-4">🧘</div>
          <h3 class="text-xl font-bold text-[#1e3d29] mb-2">Workshops & Retreats</h3>
          <p class="text-gray-600 text-sm leading-relaxed">Yoga, mindfulness, art classes — a calm, green setting that inspires creativity.</p>
        </div>

        <div class="group bg-white rounded-2xl p-8 shadow-sm hover:shadow-xl transition-all hover:-translate-y-1">
          <div class="text-4xl mb-4">💼</div>
          <h3 class="text-xl font-bold text-[#1e3d29] mb-2">Corporate Events</h3>
          <p class="text-gray-600 text-sm leading-relaxed">Off-sites, team building and private meetings in an atmosphere unlike any conference room.</p>
        </div>

        <div class="group bg-white rounded-2xl p-8 shadow-sm hover:shadow-xl transition-all hover:-translate-y-1">
          <div class="text-4xl mb-4">🎬</div>
          <h3 class="text-xl font-bold text-[#1e3d29] mb-2">Filming & Photoshoots</h3>
          <p class="text-gray-600 text-sm leading-relaxed">A photogenic backdrop with natural light, garden scenes, and characterful interiors.</p>
        </div>

        <div class="group bg-white rounded-2xl p-8 shadow-sm hover:shadow-xl transition-all hover:-translate-y-1">
          <div class="text-4xl mb-4">📚</div>
          <h3 class="text-xl font-bold text-[#1e3d29] mb-2">Tutoring & Classes</h3>
          <p class="text-gray-600 text-sm leading-relaxed">Private lessons, summer camps and after-school activities in fully-equipped classrooms.</p>
        </div>

        <div class="group bg-white rounded-2xl p-8 shadow-sm hover:shadow-xl transition-all hover:-translate-y-1">
          <div class="text-4xl mb-4">🥂</div>
          <h3 class="text-xl font-bold text-[#1e3d29] mb-2">Private Celebrations</h3>
          <p class="text-gray-600 text-sm leading-relaxed">Receptions, anniversaries and intimate gatherings in a setting that feels worlds away.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Spaces Available -->
  <section id="spaces" class="py-20 lg:py-28 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <span class="inline-block px-4 py-2 bg-[#2d5a3d]/10 rounded-full text-[#2d5a3d] font-semibold text-sm mb-4">Our Spaces</span>
        <h2 class="text-3xl md:text-5xl font-bold text-[#1e3d29] mb-4">Choose Your Setting</h2>
        <p class="text-gray-600 text-lg max-w-2xl mx-auto">
          Book a single space or the whole campus — flexible configurations tailored to your event.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="bg-gradient-to-br from-[#faf8f5] to-white rounded-2xl p-8 shadow-sm border border-[#c9a962]/10">
          <div class="w-14 h-14 bg-[#2d5a3d]/10 rounded-2xl flex items-center justify-center mb-5">
            <svg class="w-7 h-7 text-[#2d5a3d]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 21V7l9-4 9 4v14M9 21V9m6 12V9"/>
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-[#1e3d29] mb-3">Classrooms</h3>
          <p class="text-gray-600 leading-relaxed mb-4">Bright, well-equipped rooms with whiteboards, projectors and seating for up to 25.</p>
          <ul class="text-sm text-gray-600 space-y-1">
            <li class="flex items-center gap-2"><span class="text-[#2d5a3d]">✓</span> Wi-Fi & A/V equipment</li>
            <li class="flex items-center gap-2"><span class="text-[#2d5a3d]">✓</span> Flexible seating</li>
            <li class="flex items-center gap-2"><span class="text-[#2d5a3d]">✓</span> Natural light</li>
          </ul>
        </div>

        <div class="bg-gradient-to-br from-[#faf8f5] to-white rounded-2xl p-8 shadow-sm border border-[#c9a962]/10">
          <div class="w-14 h-14 bg-[#2d5a3d]/10 rounded-2xl flex items-center justify-center mb-5">
            <svg class="w-7 h-7 text-[#2d5a3d]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5s3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18s-3.332.477-4.5 1.253"/>
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-[#1e3d29] mb-3">Multipurpose Hall</h3>
          <p class="text-gray-600 leading-relaxed mb-4">A spacious open hall for performances, fitness classes, presentations and receptions.</p>
          <ul class="text-sm text-gray-600 space-y-1">
            <li class="flex items-center gap-2"><span class="text-[#2d5a3d]">✓</span> Up to 120 people</li>
            <li class="flex items-center gap-2"><span class="text-[#2d5a3d]">✓</span> Sound system</li>
            <li class="flex items-center gap-2"><span class="text-[#2d5a3d]">✓</span> Adaptable layout</li>
          </ul>
        </div>

        <div class="bg-gradient-to-br from-[#faf8f5] to-white rounded-2xl p-8 shadow-sm border border-[#c9a962]/10">
          <div class="w-14 h-14 bg-[#2d5a3d]/10 rounded-2xl flex items-center justify-center mb-5">
            <svg class="w-7 h-7 text-[#2d5a3d]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-[#1e3d29] mb-3">Garden & Outdoor</h3>
          <p class="text-gray-600 leading-relaxed mb-4">A lush garden providing a tranquil outdoor setting in the middle of Paris.</p>
          <ul class="text-sm text-gray-600 space-y-1">
            <li class="flex items-center gap-2"><span class="text-[#2d5a3d]">✓</span> Mature trees & lawn</li>
            <li class="flex items-center gap-2"><span class="text-[#2d5a3d]">✓</span> Outdoor seating</li>
            <li class="flex items-center gap-2"><span class="text-[#2d5a3d]">✓</span> Catering-friendly</li>
          </ul>
        </div>

        <div class="bg-gradient-to-br from-[#faf8f5] to-white rounded-2xl p-8 shadow-sm border border-[#c9a962]/10">
          <div class="w-14 h-14 bg-[#2d5a3d]/10 rounded-2xl flex items-center justify-center mb-5">
            <svg class="w-7 h-7 text-[#2d5a3d]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-[#1e3d29] mb-3">Swimming Pool</h3>
          <p class="text-gray-600 leading-relaxed mb-4">A heated pool perfect for swim lessons, parties or private use with a qualified lifeguard.</p>
          <ul class="text-sm text-gray-600 space-y-1">
            <li class="flex items-center gap-2"><span class="text-[#2d5a3d]">✓</span> Lifeguard on duty</li>
            <li class="flex items-center gap-2"><span class="text-[#2d5a3d]">✓</span> Changing rooms</li>
            <li class="flex items-center gap-2"><span class="text-[#2d5a3d]">✓</span> Heated water</li>
          </ul>
        </div>

        <div class="bg-gradient-to-br from-[#faf8f5] to-white rounded-2xl p-8 shadow-sm border border-[#c9a962]/10">
          <div class="w-14 h-14 bg-[#2d5a3d]/10 rounded-2xl flex items-center justify-center mb-5">
            <svg class="w-7 h-7 text-[#2d5a3d]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-[#1e3d29] mb-3">Kitchen & Catering</h3>
          <p class="text-gray-600 leading-relaxed mb-4">Fully-equipped commercial kitchen — bring your own caterer or use our partners.</p>
          <ul class="text-sm text-gray-600 space-y-1">
            <li class="flex items-center gap-2"><span class="text-[#2d5a3d]">✓</span> Professional appliances</li>
            <li class="flex items-center gap-2"><span class="text-[#2d5a3d]">✓</span> Catering partners</li>
            <li class="flex items-center gap-2"><span class="text-[#2d5a3d]">✓</span> Dining space</li>
          </ul>
        </div>

        <div class="bg-gradient-to-br from-[#2d5a3d] to-[#1e3d29] rounded-2xl p-8 shadow-lg text-white relative overflow-hidden">
          <div class="absolute top-4 right-4 px-3 py-1 bg-[#c9a962] text-white text-xs font-bold rounded-full">BEST VALUE</div>
          <div class="w-14 h-14 bg-white/10 rounded-2xl flex items-center justify-center mb-5">
            <svg class="w-7 h-7 text-[#c9a962]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>
            </svg>
          </div>
          <h3 class="text-2xl font-bold mb-3">Whole Campus</h3>
          <p class="text-white/80 leading-relaxed mb-4">Book the entire site for full privacy and unrestricted use of all facilities.</p>
          <ul class="text-sm text-white/90 space-y-1">
            <li class="flex items-center gap-2"><span class="text-[#c9a962]">✓</span> All spaces included</li>
            <li class="flex items-center gap-2"><span class="text-[#c9a962]">✓</span> Exclusive access</li>
            <li class="flex items-center gap-2"><span class="text-[#c9a962]">✓</span> Preferred pricing</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="py-20 lg:py-28 bg-[#1e3d29] relative overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute inset-0 bg-[url('data:image/svg+xml,%3Csvg width=\"60\" height=\"60\" viewBox=\"0 0 60 60\" xmlns=\"http://www.w3.org/2000/svg\"%3E%3Cg fill=\"none\" fill-rule=\"evenodd\"%3E%3Cg fill=\"%23ffffff\" fill-opacity=\"0.1\"%3E%3Cpath d=\"M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\"/%3E%3C/g%3E%3C/g%3E%3C/svg%3E')]"></div>
    </div>
    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <span class="inline-block px-4 py-2 bg-[#c9a962]/20 rounded-full text-[#c9a962] font-semibold text-sm mb-4 border border-[#c9a962]/30">Why Forest International</span>
        <h2 class="text-3xl md:text-5xl font-bold text-white mb-4">More Than Just a Venue</h2>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <div class="text-center text-white">
          <div class="w-16 h-16 bg-[#c9a962]/20 rounded-2xl flex items-center justify-center mb-4 mx-auto">
            <span class="text-3xl">🌳</span>
          </div>
          <h3 class="text-xl font-bold mb-2 text-[#c9a962]">Rare Greenery</h3>
          <p class="text-white/80 leading-relaxed">A genuine garden in central Paris — a setting your guests won't forget.</p>
        </div>
        <div class="text-center text-white">
          <div class="w-16 h-16 bg-[#c9a962]/20 rounded-2xl flex items-center justify-center mb-4 mx-auto">
            <span class="text-3xl">🚇</span>
          </div>
          <h3 class="text-xl font-bold mb-2 text-[#c9a962]">Easy Access</h3>
          <p class="text-white/80 leading-relaxed">Steps from metro lines in the prestigious 16ᵉ arrondissement, with parking nearby.</p>
        </div>
        <div class="text-center text-white">
          <div class="w-16 h-16 bg-[#c9a962]/20 rounded-2xl flex items-center justify-center mb-4 mx-auto">
            <span class="text-3xl">🤝</span>
          </div>
          <h3 class="text-xl font-bold mb-2 text-[#c9a962]">Full Support</h3>
          <p class="text-white/80 leading-relaxed">A dedicated coordinator to help you plan, set up, and run a flawless event.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 lg:py-28 bg-gradient-to-br from-[#faf8f5] to-white relative overflow-hidden">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative">
      <span class="inline-block px-4 py-2 bg-[#c9a962]/20 rounded-full text-[#c9a962] font-semibold text-sm mb-6 border border-[#c9a962]/30">Limited Availability</span>
      <h2 class="text-3xl md:text-5xl font-bold text-[#1e3d29] mb-6">Let's Make Your Event Unforgettable</h2>
      <p class="text-gray-600 text-lg md:text-xl mb-10 max-w-2xl mx-auto leading-relaxed">
        Tell us about your event and we'll send you availability, pricing, and a tailored proposal within 24 hours.
      </p>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <a href="/contact" class="inline-flex items-center justify-center px-10 py-5 bg-gradient-to-r from-[#2d5a3d] to-[#4a7c5c] text-white font-bold rounded-full hover:from-[#1e3d29] hover:to-[#2d5a3d] transition-all shadow-xl hover:shadow-2xl hover:-translate-y-0.5 text-lg">
          Get a Quote
          <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
        <a href="https://wa.me/33632727145" class="inline-flex items-center justify-center px-10 py-5 bg-white border-2 border-[#2d5a3d] text-[#2d5a3d] font-bold rounded-full hover:bg-[#2d5a3d] hover:text-white transition-all shadow-lg text-lg">
          <span class="mr-2">💬</span> WhatsApp Us
        </a>
      </div>
      <p class="text-sm text-gray-500 mt-6">📞 +33 6 32 72 71 45 — Response within 24 hours</p>
    </div>
  </section>
</Layout>
