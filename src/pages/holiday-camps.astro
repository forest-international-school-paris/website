---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionChooser from '../components/SectionChooser.astro';
import CampList, { type Camp, type CampFact } from '../components/CampList.astro';
import '../styles/camps.css';
import VisitBand from '../components/VisitBand.astro';
import { ArrowRight, ArrowUpRight } from '@lucide/astro';

const alternates = [
  { hreflang: 'en', href: '/holiday-camps/' },
  { hreflang: 'fr', href: '/fr/stages-vacances/' },
  { hreflang: 'x-default', href: '/holiday-camps/' },
];

const masterClassRegisterUrl = 'https://docs.google.com/forms/d/e/1FAIpQLSenMtdBQPV1w-LJjl6SLFV07K6GGkGf-lx760_lxrqfrFMrEA/viewform';
const bookVisitUrl = 'https://calendar.app.google/4Pur5YQjQC8tXjdj7';
const campRegisterUrl = 'https://forms.gle/6y8k9xULoLzSCt7n7';

const PHOTO_ALT = 'Summer camp collage: children running on a lawn, a swimming session in the school pool, smiling children outdoors and a child climbing a tree';

// Facts that are identical for every camp are listed once, above the schedule.
const sharedFacts: CampFact[] = [
  { label: 'Food', value: '40 €/week, snacks included' },
  { label: 'Transport', value: 'On request — Saint-Germain-en-Laye, Le Pecq & Paris 16' },
];

const camps: Camp[] = [
  {
    key: 'autumn',
    season: 'Autumn',
    title: 'October Toussaint Camp',
    registerUrl: campRegisterUrl,
    description: 'An autumn week of nature, creative workshops and outdoor exploration.',
    dates: '19th – 23rd October 2026',
    hours: 'Daily 10:00 am – 4:00 pm',
    rate: '450 €/week',
  },
  {
    key: 'winter',
    season: 'Winter',
    title: 'February Winter Camp',
    registerUrl: campRegisterUrl,
    description: 'A winter week of nature-based learning, creative projects and outdoor activities.',
    dates: '8th – 12th February 2027',
    hours: 'Daily 10:00 am – 4:00 pm',
    rate: '450 €/week',
  },
  {
    key: 'spring',
    season: 'Spring',
    title: 'Spring Holiday Camp',
    registerUrl: campRegisterUrl,
    description: 'A spring week of flowers, activities and plenty of time in nature.',
    dates: '5th – 9th April 2027',
    hours: 'Daily 10:00 am – 4:00 pm',
    rate: '450 €/week',
  },
  {
    key: 'summer-2027',
    season: 'Summer',
    title: 'Holiday Summer Camp 2027',
    registerUrl: 'https://forms.gle/5JfDd3U13ZTYMvK76',
    description: 'A mix of outdoor activities, including time in our swimming pool and quieter hours in the shade of the forest trees.',
    sessions: { month: 'July 2027', weeks: ['5th – 9th', '12th – 16th', '19th – 23rd'] },
    hours: 'Daily 10:00 am – 5:00 pm',
    rate: '480 €/week',
    extra: { label: 'Early Drop-off / Late Pick-up', value: '9:00 am & 6:00 pm — 40 €/day' },
    photo: { src: '/images/summer-camp.jpg', alt: PHOTO_ALT, width: 572, height: 459 },
  },
];
---

<Layout title="Holiday Camps & Wednesday MasterClasses near Paris" description="English-language holiday and summer camps for children aged 2-12, and Wednesday MasterClasses, on our forest campus near Saint-Germain-en-Laye, west of Paris." alternates={alternates}>
  <PageHero kicker="Holiday camps · Wednesday MasterClasses · Mareil-Marly">
    <Fragment slot="title"><span class="title-holidays">Holidays</span> <span class="title-amp">&amp;</span> <span class="title-wednesdays">Wednesdays</span></Fragment>
    <Fragment slot="intro">During the school holidays, children spend their days outdoors and in English on our forest campus. Camps are open to all children aged 2–12, whether or not they attend Forest during the school year. On Wednesdays, MasterClasses offer hands-on English enrichment workshops.</Fragment>
    <a href="/contact/" class="link-on-dark">Contact us <ArrowRight size={18} aria-hidden="true" /></a>
    <a href="/fr/stages-vacances/" lang="fr" hreflang="fr" class="link-on-dark">Voir cette page en français</a>
    <SectionChooser slot="aside" label="On this page" choices={[
      { href: '#camps', title: 'Holiday camps', detail: 'Autumn, winter, spring and summer weeks · Ages 2–12 · Open to all children', action: 'See camp dates', tone: 'gold' },
      { href: '#masterclasses', title: 'Wednesday MasterClasses', detail: 'Every Wednesday · Early Years & Lower Primary · Waitlist only', action: 'See MasterClasses', tone: 'leaf' },
    ]} />
  </PageHero>

  <section id="camps" class="page-section" aria-labelledby="camps-title">
    <div class="container-main">
      <div class="camps-intro">
        <div class="prose-copy">
          <h2 id="camps-title">Camp dates, hours and rates</h2>
          <p>The 2026/27 programme, from the October holidays to July.</p>
        </div>
      </div>

      <CampList camps={camps} sharedFacts={sharedFacts} labels={{ shared: "For every camp", sessions: "Weekly sessions", register: "Register", registerHint: (title) => ` for the ${title} (opens in a new tab)` }} />
    </div>
  </section>

  <section id="masterclasses" class="page-section surface" aria-labelledby="masterclasses-title">
    <div class="container-main split-layout">
      <div class="prose-copy">
        <h2 id="masterclasses-title">Wednesday MasterClasses</h2>
        <p>Hands-on English enrichment workshops every Wednesday, for creative, curious learning outside the classroom.</p>
      </div>
      <div>
        <dl class="fact-list">
          <div><dt>When</dt><dd>Every Wednesday</dd></div>
          <div><dt>For</dt><dd>Early Years &amp; Lower Primary</dd></div>
          <div><dt>Places</dt><dd>Waitlist only</dd></div>
          <div><dt>Fees</dt><dd><a href="/tuition/">See the Wednesday MasterClass column on the tuition page</a></dd></div>
        </dl>
        <div class="masterclass-actions">
          <a href={masterClassRegisterUrl} target="_blank" rel="noopener noreferrer" class="btn-primary">
            Register<span class="sr-only"> for Wednesday MasterClasses (opens in a new tab)</span>
            <ArrowUpRight size={18} aria-hidden="true" />
          </a>
          <a href={bookVisitUrl} target="_blank" rel="noopener noreferrer" class="text-link">
            Book a visit<span class="sr-only"> (opens in a new tab)</span>
            <ArrowUpRight size={18} aria-hidden="true" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <VisitBand title="Beyond the holidays">
    <p class="beyond-copy">
      If your child loves camp, school here feels much the same — outdoors, in English, every day. Explore
      <a href="/early-years/">Early Years (ages 2–5)</a>,
      <a href="/primary/">Primary (ages 6–11)</a> and
      <a href="/middle-school/">Middle School (ages 11–15)</a>,
      see <a href="/tuition/">tuition fees</a>,
      or visit <a href="/admissions/">admissions</a> — applications are open year-round.
    </p>
    <Fragment slot="actions">
      <a href="/admissions/" class="btn-gold">Learn about admissions <ArrowRight size={18} aria-hidden="true" /></a>
      <a href="/contact/" class="link-on-dark">Contact us <ArrowRight size={18} aria-hidden="true" /></a>
    </Fragment>
  </VisitBand>
</Layout>
