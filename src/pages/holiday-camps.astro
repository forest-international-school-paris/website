---
import Layout from '../layouts/Layout.astro';

const alternates = [
  { hreflang: 'en', href: '/holiday-camps' },
  { hreflang: 'fr', href: '/fr/stages-vacances' },
  { hreflang: 'x-default', href: '/holiday-camps' },
];

const masterClassRegisterUrl = 'https://docs.google.com/forms/d/e/1FAIpQLSenMtdBQPV1w-LJjl6SLFV07K6GGkGf-lx760_lxrqfrFMrEA/viewform';
const bookVisitUrl = 'https://calendar.app.google/4Pur5YQjQC8tXjdj7';
---

<Layout title="Holiday Camps in English near Paris" description="English-language holiday and summer camps for children aged 2-12 on our forest campus near Saint-Germain-en-Laye, west of Paris." alternates={alternates}>
  <!-- Hero Section with Image -->
  <section class="relative min-h-[60vh] flex items-center">
    <div class="absolute inset-0">
      <img
        src="/images/summer-camp.jpg"
        alt="Holiday camps at Forest International School Paris in Mareil-Marly"
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-[#1e3d29]/90 to-[#2d5a3d]/70"></div>
    </div>
    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
      <div class="max-w-2xl">
        <div class="mb-4">
          <a href="/fr/stages-vacances" lang="fr" hreflang="fr" class="inline-flex items-center gap-2 px-4 py-2 bg-white/10 backdrop-blur-sm rounded-full text-white text-sm font-medium border border-white/25 hover:bg-white/20 transition-colors">
            🇫🇷 Voir cette page en français
          </a>
        </div>
        <span class="inline-block px-4 py-2 bg-[#c9a962] text-[#1e3d29] rounded-full font-bold text-sm mb-6">
          OPEN TO ALL CHILDREN
        </span>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6 leading-tight">
          Holiday Camps in English, West of Paris
        </h1>
        <p class="text-xl text-white/90 mb-8">
          Spark curiosity, creativity, and connection with nature during school holidays. Fun-filled adventures for ages 2-12!
        </p>
        <p class="text-sm text-white/70 mb-8">
          English-language camps on our forest campus in Mareil-Marly, near Saint-Germain-en-Laye — open to all children aged 2-12, whether or not they attend Forest during the school year.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="#camps" class="inline-flex items-center px-8 py-4 bg-[#c9a962] text-[#1e3d29] font-bold rounded-full hover:bg-[#d4b872] transition-colors shadow-lg">
            View Camps
            <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </a>
          <a href="/contact" class="inline-flex items-center px-8 py-4 bg-white/10 text-white font-bold rounded-full border-2 border-white/30 hover:bg-white/20 transition-colors">
            Contact Us
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Wednesday MasterClasses Banner -->
  <section id="masterclasses" class="bg-[#c9a962] py-10">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block px-4 py-1.5 bg-[#1e3d29] text-white rounded-full font-semibold text-sm mb-4">Every Wednesday</span>
      <h2 class="text-3xl md:text-4xl font-bold text-[#1e3d29] mb-3">Wednesday MasterClasses</h2>
      <p class="text-[#1e3d29]/70 mb-4 max-w-2xl mx-auto">
        Hands-on English enrichment workshops every Wednesday, designed to spark creativity, curiosity, and a love of learning outside the classroom.
      </p>
      <p class="text-[#1e3d29]/80 font-semibold mb-6">
        🎟️ Early Years &amp; Lower Primary — <span class="underline">Waitlist only</span>
      </p>
      <div class="flex flex-col sm:flex-row justify-center gap-3">
        <a href={masterClassRegisterUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center px-7 py-3 bg-[#1e3d29] text-white font-bold rounded-full hover:bg-[#2d5a3d] transition-colors shadow-lg">
          Register Now
          <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </a>
        <a href={bookVisitUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center px-7 py-3 bg-white text-[#1e3d29] font-bold rounded-full border-2 border-[#1e3d29]/15 hover:bg-[#faf8f5] transition-colors shadow-sm">
          Book a Visit
        </a>
      </div>
    </div>
  </section>

  <!-- Holiday Camps -->
  <section id="camps" class="py-16 lg:py-24 bg-[#faf8f5]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <span class="inline-block px-4 py-2 bg-[#2d5a3d]/10 rounded-full text-[#2d5a3d] font-semibold text-sm mb-4">2026/27 Programs</span>
        <h2 class="text-3xl md:text-4xl font-bold text-[#1e3d29]">Camp dates, hours and rates</h2>
      </div>

      <div class="space-y-8">
        <!-- October Camp -->
        <div class="bg-white rounded-3xl shadow-lg overflow-hidden">
          <div class="md:flex">
            <div class="md:w-2 bg-[#e07b39] shrink-0"></div>
            <div class="p-8 lg:p-10 flex-1">
              <div class="flex flex-wrap items-start justify-between gap-4 mb-4">
                <div>
                  <span class="inline-block px-3 py-1 bg-[#e07b39]/15 text-[#c05e1e] rounded-full text-xs font-semibold mb-3">Autumn</span>
                  <h3 class="text-2xl font-bold text-[#1e3d29]">October Toussaint Camp</h3>
                </div>
                <a href="https://forms.gle/6y8k9xULoLzSCt7n7" target="_blank" rel="noopener noreferrer" class="inline-flex items-center px-6 py-2.5 bg-[#2d5a3d] text-white font-semibold rounded-full hover:bg-[#1e3d29] transition-colors text-sm shrink-0">
                  Register
                  <svg class="w-4 h-4 ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                  </svg>
                </a>
              </div>
              <p class="text-gray-600 mb-6">An action-packed autumn week of nature adventures, creative workshops, and outdoor exploration.</p>
              <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 text-sm">
                <div class="bg-[#faf8f5] rounded-xl p-4">
                  <p class="text-gray-500 text-xs mb-1">Dates</p>
                  <p class="font-semibold text-[#1e3d29]">26th – 30th October 2026</p>
                </div>
                <div class="bg-[#faf8f5] rounded-xl p-4">
                  <p class="text-gray-500 text-xs mb-1">Hours</p>
                  <p class="font-semibold text-[#1e3d29]">Daily 10:00 am – 4:00 pm</p>
                </div>
                <div class="bg-[#faf8f5] rounded-xl p-4">
                  <p class="text-gray-500 text-xs mb-1">Rate</p>
                  <p class="font-semibold text-[#1e3d29]">450 €/week</p>
                </div>
                <div class="bg-[#faf8f5] rounded-xl p-4">
                  <p class="text-gray-500 text-xs mb-1">Food</p>
                  <p class="font-semibold text-[#1e3d29]">40 €/week, snacks included</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- February Camp -->
        <div class="bg-white rounded-3xl shadow-lg overflow-hidden">
          <div class="md:flex">
            <div class="md:w-2 bg-[#6baed6] shrink-0"></div>
            <div class="p-8 lg:p-10 flex-1">
              <div class="flex flex-wrap items-start justify-between gap-4 mb-4">
                <div>
                  <span class="inline-block px-3 py-1 bg-[#6baed6]/20 text-[#2d7ab0] rounded-full text-xs font-semibold mb-3">Winter</span>
                  <h3 class="text-2xl font-bold text-[#1e3d29]">February Winter Camp</h3>
                </div>
                <a href="https://forms.gle/6y8k9xULoLzSCt7n7" target="_blank" rel="noopener noreferrer" class="inline-flex items-center px-6 py-2.5 bg-[#2d5a3d] text-white font-semibold rounded-full hover:bg-[#1e3d29] transition-colors text-sm shrink-0">
                  Register
                  <svg class="w-4 h-4 ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                  </svg>
                </a>
              </div>
              <p class="text-gray-600 mb-6">Beat the winter blues with a week of nature-based learning, creative projects, and fun outdoor activities.</p>
              <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 text-sm">
                <div class="bg-[#faf8f5] rounded-xl p-4">
                  <p class="text-gray-500 text-xs mb-1">Dates</p>
                  <p class="font-semibold text-[#1e3d29]">8th – 12th February 2027</p>
                </div>
                <div class="bg-[#faf8f5] rounded-xl p-4">
                  <p class="text-gray-500 text-xs mb-1">Hours</p>
                  <p class="font-semibold text-[#1e3d29]">Daily 10:00 am – 4:00 pm</p>
                </div>
                <div class="bg-[#faf8f5] rounded-xl p-4">
                  <p class="text-gray-500 text-xs mb-1">Rate</p>
                  <p class="font-semibold text-[#1e3d29]">450 €/week</p>
                </div>
                <div class="bg-[#faf8f5] rounded-xl p-4">
                  <p class="text-gray-500 text-xs mb-1">Food</p>
                  <p class="font-semibold text-[#1e3d29]">40 €/week, snacks included</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- April Camp -->
        <div class="bg-white rounded-3xl shadow-lg overflow-hidden">
          <div class="md:flex">
            <div class="md:w-2 bg-[#7ab648] shrink-0"></div>
            <div class="p-8 lg:p-10 flex-1">
              <div class="flex flex-wrap items-start justify-between gap-4 mb-4">
                <div>
                  <span class="inline-block px-3 py-1 bg-[#7ab648]/15 text-[#5a8a30] rounded-full text-xs font-semibold mb-3">Spring</span>
                  <h3 class="text-2xl font-bold text-[#1e3d29]">Spring Holiday Camp</h3>
                </div>
                <a href="https://forms.gle/6y8k9xULoLzSCt7n7" target="_blank" rel="noopener noreferrer" class="inline-flex items-center px-6 py-2.5 bg-[#2d5a3d] text-white font-semibold rounded-full hover:bg-[#1e3d29] transition-colors text-sm shrink-0">
                  Register
                  <svg class="w-4 h-4 ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                  </svg>
                </a>
              </div>
              <p class="text-gray-600 mb-6">Celebrate spring with our holiday camp full of flowers, fun activities, and lots of nature!</p>
              <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 text-sm">
                <div class="bg-[#faf8f5] rounded-xl p-4">
                  <p class="text-gray-500 text-xs mb-1">Dates</p>
                  <p class="font-semibold text-[#1e3d29]">5th – 9th April 2027</p>
                </div>
                <div class="bg-[#faf8f5] rounded-xl p-4">
                  <p class="text-gray-500 text-xs mb-1">Hours</p>
                  <p class="font-semibold text-[#1e3d29]">Daily 10:00 am – 4:00 pm</p>
                </div>
                <div class="bg-[#faf8f5] rounded-xl p-4">
                  <p class="text-gray-500 text-xs mb-1">Rate</p>
                  <p class="font-semibold text-[#1e3d29]">450 €/week</p>
                </div>
                <div class="bg-[#faf8f5] rounded-xl p-4">
                  <p class="text-gray-500 text-xs mb-1">Food</p>
                  <p class="font-semibold text-[#1e3d29]">40 €/week, snacks included</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Summer Camp 2026 -->
        <div class="bg-white rounded-3xl shadow-lg overflow-hidden">
          <div class="md:flex">
            <div class="md:w-2 bg-[#c9a962] shrink-0"></div>
            <div class="p-8 lg:p-10 flex-1">
              <div class="flex flex-wrap items-start justify-between gap-4 mb-4">
                <div>
                  <span class="inline-block px-3 py-1 bg-[#c9a962]/20 text-[#a8872e] rounded-full text-xs font-semibold mb-3">Summer 2026</span>
                  <h3 class="text-2xl font-bold text-[#1e3d29]">Holiday Summer Camp 2026</h3>
                </div>
                <a href="https://forms.gle/Xxp1hi3qc8AdtAsCA" target="_blank" rel="noopener noreferrer" class="inline-flex items-center px-6 py-2.5 bg-[#2d5a3d] text-white font-semibold rounded-full hover:bg-[#1e3d29] transition-colors text-sm shrink-0">
                  Register
                  <svg class="w-4 h-4 ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                  </svg>
                </a>
              </div>
              <p class="text-gray-600 mb-6">Our Summer Camp offers a rich mix of outdoor activities, including splashy fun in our swimming pool, forest and orchard exploration, creative workshops, science, cooking, baking and group games.</p>
              <div class="mb-6">
                <p class="text-gray-500 text-xs mb-2">Weekly Sessions</p>
                <div class="flex flex-wrap gap-2">
                  <span class="px-3 py-1.5 bg-[#c9a962]/10 text-[#1e3d29] rounded-lg text-sm font-medium">6th – 10th July 2026</span>
                  <span class="px-3 py-1.5 bg-[#c9a962]/10 text-[#1e3d29] rounded-lg text-sm font-medium">13th – 17th July 2026 (excl. 14th)</span>
                  <span class="px-3 py-1.5 bg-[#c9a962]/10 text-[#1e3d29] rounded-lg text-sm font-medium">20th – 24th July 2026</span>
                </div>
              </div>
              <div class="grid sm:grid-cols-2 gap-4 text-sm">
                <div class="bg-[#faf8f5] rounded-xl p-4">
                  <p class="text-gray-500 text-xs mb-1">Hours</p>
                  <p class="font-semibold text-[#1e3d29]">Daily 10:00 am – 5:00 pm</p>
                </div>
                <div class="bg-[#faf8f5] rounded-xl p-4">
                  <p class="text-gray-500 text-xs mb-1">Rate</p>
                  <p class="font-semibold text-[#1e3d29]">425 €/week</p>
                </div>
                <div class="bg-[#faf8f5] rounded-xl p-4">
                  <p class="text-gray-500 text-xs mb-1">Food</p>
                  <p class="font-semibold text-[#1e3d29]">40 €/week, snacks included</p>
                </div>
                <div class="bg-[#faf8f5] rounded-xl p-4">
                  <p class="text-gray-500 text-xs mb-1">Early Drop-off / Late Pick-up</p>
                  <p class="font-semibold text-[#1e3d29]">9:30 am & 5:30 pm — 40 €/day</p>
                </div>
              </div>
              <p class="text-sm text-gray-600 mt-5">
                Optional private swimming classes and transportation from Saint-Germain-en-Laye/Le Pecq and Paris 16 are available on a first-come-first-served basis.
                <a href="https://forms.gle/ZZJ8tFxyJnEQXpEf6" target="_blank" rel="noopener noreferrer" class="text-[#2d5a3d] font-semibold underline hover:text-[#1e3d29]">Request swimming or transportation</a>.
                Read more in our
                <a href="/news/summer-school-paris-2026-english-camp" class="text-[#2d5a3d] font-semibold underline hover:text-[#1e3d29]">Summer School Paris 2026 article</a>.
              </p>
            </div>
          </div>
        </div>

        <!-- Summer Camp 2027 -->
        <div class="bg-white rounded-3xl shadow-lg overflow-hidden">
          <div class="md:flex">
            <div class="md:w-2 bg-[#c9a962] shrink-0"></div>
            <div class="p-8 lg:p-10 flex-1">
              <div class="flex flex-wrap items-start justify-between gap-4 mb-4">
                <div>
                  <span class="inline-block px-3 py-1 bg-[#c9a962]/20 text-[#a8872e] rounded-full text-xs font-semibold mb-3">Summer 2027</span>
                  <h3 class="text-2xl font-bold text-[#1e3d29]">Holiday Summer Camp 2027</h3>
                </div>
                <a href="https://forms.gle/5JfDd3U13ZTYMvK76" target="_blank" rel="noopener noreferrer" class="inline-flex items-center px-6 py-2.5 bg-[#2d5a3d] text-white font-semibold rounded-full hover:bg-[#1e3d29] transition-colors text-sm shrink-0">
                  Register
                  <svg class="w-4 h-4 ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                  </svg>
                </a>
              </div>
              <p class="text-gray-600 mb-6">Our Summer Camp offers a rich mix of outdoor activities, including splashy fun in our swimming pool and chill-out forest time in the shadows of its trees.</p>
              <div class="mb-6">
                <p class="text-gray-500 text-xs mb-2">Weekly Sessions</p>
                <div class="flex flex-wrap gap-2">
                  <span class="px-3 py-1.5 bg-[#c9a962]/10 text-[#1e3d29] rounded-lg text-sm font-medium">5th – 9th July 2027</span>
                  <span class="px-3 py-1.5 bg-[#c9a962]/10 text-[#1e3d29] rounded-lg text-sm font-medium">12th – 16th July 2027</span>
                  <span class="px-3 py-1.5 bg-[#c9a962]/10 text-[#1e3d29] rounded-lg text-sm font-medium">19th – 23rd July 2027</span>
                </div>
              </div>
              <div class="grid sm:grid-cols-2 gap-4 text-sm">
                <div class="bg-[#faf8f5] rounded-xl p-4">
                  <p class="text-gray-500 text-xs mb-1">Hours</p>
                  <p class="font-semibold text-[#1e3d29]">Daily 10:00 am – 5:00 pm</p>
                </div>
                <div class="bg-[#faf8f5] rounded-xl p-4">
                  <p class="text-gray-500 text-xs mb-1">Rate</p>
                  <p class="font-semibold text-[#1e3d29]">480 €/week</p>
                </div>
                <div class="bg-[#faf8f5] rounded-xl p-4">
                  <p class="text-gray-500 text-xs mb-1">Food</p>
                  <p class="font-semibold text-[#1e3d29]">40 €/week, snacks included</p>
                </div>
                <div class="bg-[#faf8f5] rounded-xl p-4">
                  <p class="text-gray-500 text-xs mb-1">Early Drop-off / Late Pick-up</p>
                  <p class="font-semibold text-[#1e3d29]">9:00 am & 6:00 pm — 40 €/day</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Beyond the holidays -->
  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-[#1e3d29] mb-4">Beyond the holidays</h2>
      <p class="text-gray-600 mb-8 max-w-2xl mx-auto">
        If your child loves camp, school here feels much the same — outdoors, in English, every day. Explore
        <a href="/early-years" class="text-[#2d5a3d] font-semibold underline hover:text-[#1e3d29]">Early Years (ages 2-5)</a>,
        <a href="/primary" class="text-[#2d5a3d] font-semibold underline hover:text-[#1e3d29]">Primary (ages 6-11)</a> and
        <a href="/middle-school" class="text-[#2d5a3d] font-semibold underline hover:text-[#1e3d29]">Middle School (ages 11-14)</a>,
        see <a href="/tuition" class="text-[#2d5a3d] font-semibold underline hover:text-[#1e3d29]">tuition fees</a>,
        or visit <a href="/admissions" class="text-[#2d5a3d] font-semibold underline hover:text-[#1e3d29]">admissions</a> — applications are open year-round.
      </p>
      <a href="/admissions" class="inline-flex items-center px-8 py-4 bg-[#2d5a3d] text-white font-bold rounded-full hover:bg-[#1e3d29] transition-colors shadow-lg">
        Learn about admissions
      </a>
    </div>
  </section>
</Layout>
