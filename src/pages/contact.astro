---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { ArrowDown, ArrowUpRight } from '@lucide/astro';
import { mailHref, mapsUrl, school, schoolHours, whatsappHref } from '../lib/site';

const [street, ...locality] = school.address.split(', ');
const bookingUrl = 'https://calendar.app.google/4Pur5YQjQC8tXjdj7';
const enquiryUrl = 'https://docs.google.com/forms/d/e/1FAIpQLSfMa-d1ZWAsQUoe6ximaoczCAw5CK7YS1CHOKs6NSV-M8AjCQ/viewform?usp=header';
---

<Layout title="Contact Us" description="Contact Forest International School Paris in Mareil-Marly, west of Paris — book a visit, ask about admissions, or find our campus near Saint-Germain-en-Laye.">
  <PageHero title="Visit or contact the school" kicker="Mareil-Marly · near Saint-Germain-en-Laye" image={{ src: '/images/campus.jpg', width: 1920, height: 1059, position: 'center' }}>
    <Fragment slot="intro">Book a tour with our Principal, send us a question, or find our campus in Mareil-Marly, just outside Paris.</Fragment>
    <a href="#visit" class="btn-gold">Book a visit <ArrowDown size={18} aria-hidden="true" /></a>
    <a href="#enquiry" class="link-on-dark">Ask a question <ArrowDown size={18} aria-hidden="true" /></a>
  </PageHero>

  <section id="visit" class="page-section" aria-labelledby="visit-title">
    <div class="container-main visit-layout">
      <div class="principal">
        <h2 id="visit-title">Schedule your visit</h2>
        <p class="visit-intro">See Forest International School for yourself. Book a personal tour with our Principal.</p>
        <figure class="principal-card">
          <img src="/images/team/sophie-lovejoy-2026.jpeg" alt="Ms. Sophie Lovejoy, Principal" width="988" height="1595" loading="lazy" />
          <figcaption>
            <h3>Ms. Sophie Lovejoy</h3>
            <p class="principal-role">Principal</p>
            <p class="principal-note">Schedule a personal tour with our Principal to discover what makes Forest International School unique.</p>
          </figcaption>
        </figure>
        <!-- Phones and tablets: the booking page opens in a new tab instead of the embedded calendar. -->
        <a href={bookingUrl} target="_blank" rel="noopener noreferrer" class="btn-gold booking-link lg:hidden">Book a visit <ArrowUpRight size={18} aria-hidden="true" /><span class="sr-only"> (opens in a new tab)</span></a>
      </div>

      <div class="booking-frame hidden lg:block">
            <iframe
              src="https://calendar.google.com/calendar/appointments/schedules/AcZssZ3BwRc8i2hXQXTgyvaJzbbEI_OfumEfJ1j-kzQily4y2LtMOEhEclgDQbsIGfIVZlTwicpRubMa?gv=true"
              width="100%"
              height="650"
              frameborder="0"
              scrolling="no"
              style="border:0; border-radius: 1rem; overflow: hidden;"
              loading="lazy"
              title="Book a Visit - Forest International School">
            </iframe>
      </div>
    </div>
  </section>

  <section id="enquiry" class="page-section surface" aria-labelledby="enquiry-title">
    <div class="container-main split-layout">
      <div class="prose-copy">
        <h2 id="enquiry-title">Ask us a question</h2>
        <p>Whether your question is about admissions, the curriculum or school life, fill out our enquiry form and we will reply within 24–48 hours.</p>
        <a href={enquiryUrl} target="_blank" rel="noopener noreferrer" class="btn-primary enquiry-link">Make an enquiry <ArrowUpRight size={18} aria-hidden="true" /><span class="sr-only"> (opens in a new tab)</span></a>
      </div>

      <div>
        <h2 class="details-title">Contact details</h2>
        <dl class="fact-list">
          <div>
            <dt>Address</dt>
            <dd>
              {street}<br />{locality.join(', ')}<br />
              <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="detail-link">View map<span class="sr-only"> (opens in a new tab)</span></a>
            </dd>
          </div>
          <div>
            <dt>WhatsApp</dt>
            <dd><a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="detail-link">{school.phone}<span class="sr-only"> (opens WhatsApp in a new tab)</span></a></dd>
          </div>
          <div>
            <dt>Email</dt>
            <dd><a href={mailHref} class="detail-link email">{school.email}</a></dd>
          </div>
          <div>
            <dt>Hours</dt>
            <dd>
              <ul class="hours">
                {schoolHours.map((row) => <li><span>{row.label}:</span> {row.value}</li>)}
              </ul>
            </dd>
          </div>
        </dl>
      </div>
    </div>

    <div class="container-main">
      <div class="map-block">
        <div class="map-frame">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d246.12827643040475!2d2.0651507206890485!3d48.87420047615408!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47e688659cd65379%3A0xa8d0df24e2c7603!2sForest%20International%20School%20Paris!5e0!3m2!1sen!2sfr!4v1768251485011!5m2!1sen!2sfr"
            width="100%"
            height="300"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="rounded-[var(--radius-media)]"
            title="Forest International School Paris Location">
          </iframe>
        </div>
        <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="text-link">Open in Google Maps <ArrowUpRight size={18} aria-hidden="true" /><span class="sr-only"> (opens in a new tab)</span></a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .visit-layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.75fr); gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  .visit-intro { max-width: 40ch; line-height: 1.75; }

  .principal-card { display: grid; grid-template-columns: 7.5rem minmax(0, 1fr); gap: 1.5rem; align-items: start; margin-top: 2rem; padding-top: 2rem; border-top: 1px solid var(--color-line); }
  .principal-card img { width: 100%; aspect-ratio: 5/6; object-fit: cover; object-position: 50% 10%; border-radius: var(--radius-media); }
  .principal-card h3 { font-size: 1.375rem; line-height: 1.3; }
  .principal-role { margin-top: .125rem; font-size: .9375rem; font-weight: 600; color: var(--color-gold-ink); }
  .principal-note { margin-top: .75rem; font-size: .9375rem; line-height: 1.65; color: var(--color-text-muted); }
  .booking-link { margin-top: 2rem; }

  .booking-frame { overflow: hidden; padding: 1rem; border: 1px solid var(--color-line); border-radius: var(--radius-media); background: white; }
  .booking-frame iframe { display: block; }

  .enquiry-link { margin-top: 1.75rem; }
  .details-title { font-size: 1.5rem; line-height: 1.3; margin-bottom: 1rem; }
  .detail-link { display: inline-flex; align-items: center; min-height: 44px; }
  .email { overflow-wrap: anywhere; }
  .hours { display: grid; gap: .25rem; }
  .hours span { font-weight: 600; color: var(--color-forest-dark); }

  .map-block { margin-top: clamp(2.5rem, 5vw, 4rem); }
  .map-frame { overflow: hidden; border-radius: var(--radius-media); background: white; }
  .map-frame iframe { display: block; }
  .map-block .text-link { margin-top: .75rem; }

  @media (max-width: 1023px) {
    .visit-layout { grid-template-columns: 1fr; }
    .principal { max-width: 36rem; }
  }
  @media (max-width: 400px) {
    .principal-card { grid-template-columns: 6.5rem minmax(0, 1fr); gap: 1rem; }
  }
</style>
