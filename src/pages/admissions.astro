---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import VisitBand from '../components/VisitBand.astro';
import { ArrowRight, ArrowUpRight } from '@lucide/astro';

const alternates = [
  { hreflang: 'en', href: '/admissions/' },
  { hreflang: 'fr', href: '/fr/admissions/' },
  { hreflang: 'x-default', href: '/admissions/' },
];

const applicationUrl = 'https://docs.google.com/forms/d/e/1FAIpQLSdzobNF-7dTwJnfd8-poukuc0ICQ0o_-AAdhsxRJ2KPhg_VGA/viewform';

const steps = [
  { title: 'Submit your application', text: 'Fill out our application form to express your interest, and register for an Open Day to visit the school and meet our team.' },
  { title: 'Schedule a tour', text: 'Come for an in-person visit, arrange a virtual meeting, or join an upcoming Open Day.' },
  { title: 'Apply', text: 'If Forest International is the right fit, submit your application with the required documentation.' },
  { title: 'Acceptance', text: 'Once your child is accepted, we confirm their place at FISP. A dedicated member of the admissions team guides you through the process.' },
];
---

<Layout title="Admissions — Apply to an English School in West Paris" description="How to apply to Forest International School Paris, an English-language school in Mareil-Marly, west of Paris. Admissions all year, no birthday cut-off." alternates={alternates}>
  <PageHero
    title="Admissions"
    kicker="Ages 2–15 · Applications open all year · Mareil-Marly"
    intro="We welcome families from around the world to our school in Mareil-Marly, near Saint-Germain-en-Laye. Here is how to apply, from your first visit to a confirmed place."
    image={{ src: '/images/children-diversity.jpg', alt: 'Pupils in Forest uniforms holding tall drawn balloons on the school lawn', width: 1024, height: 768, position: '50% 35%' }}
  >
    <a href={applicationUrl} target="_blank" rel="noopener noreferrer" class="btn-gold">Apply <ArrowUpRight size={18} aria-hidden="true" /><span class="sr-only"> (opens in a new tab)</span></a>
    <a href="/contact/" class="link-on-dark">Book a visit <ArrowRight size={18} aria-hidden="true" /></a>
    <a href="/fr/admissions/" lang="fr" hreflang="fr" class="link-on-dark">Voir cette page en français</a>
  </PageHero>

  <section class="page-section" aria-labelledby="process-title">
    <div class="container-main split-layout">
      <div class="prose-copy">
        <h2 id="process-title">How to apply</h2>
        <p class="lead-copy">Applications are open all year round.</p>
        <p>Our admissions process is there to make sure the school and your child are a good fit. Our annual fees are published on the <a href="/tuition/" class="inline-link">tuition page</a>.</p>
      </div>
      <ol class="step-list">
        {steps.map((step, index) => (
          <li>
            <span class="step-number" aria-hidden="true">{index + 1}</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
              {index === 0 && (
                <a href={applicationUrl} target="_blank" rel="noopener noreferrer" class="text-link">Open the application form <ArrowUpRight size={18} aria-hidden="true" /><span class="sr-only"> (opens in a new tab)</span></a>
              )}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="page-section surface" aria-labelledby="key-info-title">
    <div class="container-main split-layout">
      <div>
        <h2 id="key-info-title">Good to know</h2>
        <dl class="fact-list">
          <div><dt>Applications</dt><dd>Accepted throughout the school year</dd></div>
          <div><dt>Waiting lists</dt><dd>We prefer not to operate waiting lists. <a href="/contact/">Contact us</a> to check availability.</dd></div>
          <div><dt>Ages</dt><dd>Early Years (from 2 years) to Middle School (up to 15 years)</dd></div>
          <div><dt>Birthday cut-off</dt><dd>None</dd></div>
          <div><dt>Fees</dt><dd>Published on the <a href="/tuition/">tuition page</a></dd></div>
        </dl>
      </div>
      <div class="prose-copy">
        <h2 id="compare-title">Comparing schools?</h2>
        <p>Our <a href="/news/international-school-paris-visit-checklist/" class="inline-link">international school visit checklist</a> can help you prepare useful questions before you book a tour.</p>
        <p>If you are looking from west Paris, Saint-Germain-en-Laye, L'Étang-la-Ville or nearby communes, our <a href="/news/english-school-paris-pre-elementary-primary/" class="inline-link">English pre-elementary and primary school comparison</a> is a useful read.</p>
      </div>
    </div>
  </section>

  <VisitBand title="Talk to the admissions team">
    <p>Contact our admissions team to start the application process or schedule a visit.</p>
    <Fragment slot="actions">
      <a href="/contact/" class="btn-gold">Book a visit <ArrowRight size={18} aria-hidden="true" /></a>
      <a href="/tuition/" class="link-on-dark">View tuition <ArrowRight size={18} aria-hidden="true" /></a>
    </Fragment>
  </VisitBand>
</Layout>

<style>
  #compare-title { font-size: clamp(1.5rem, 2.2vw, 1.875rem); }
</style>
