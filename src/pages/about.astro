---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import PortraitList from '../components/PortraitList.astro';
import VisitBand from '../components/VisitBand.astro';
import { ArrowRight, ArrowUpRight } from '@lucide/astro';
import { mapsUrl, programmeLinks } from '../lib/site';
import type { Person } from '../components/PortraitList.astro';

const enquiryUrl = 'https://docs.google.com/forms/d/e/1FAIpQLSfMa-d1ZWAsQUoe6ximaoczCAw5CK7YS1CHOKs6NSV-M8AjCQ/viewform?usp=header';

const approach = [
  { title: 'Each child at the centre', text: 'Every child is different and learns best when they are happy. Teaching starts from the child in front of us.' },
  { title: 'Learning through projects', text: 'Projects connect subjects to the real world and give children practice in asking questions, thinking critically and working together.' },
  { title: 'The forest, all year round', text: 'In every season, the forest is an extension of the classroom, a place for exploration, observation and discovery.' },
  { title: 'Small, mixed-age classes', text: 'Classes have no more than 15 pupils across combined age groups. Teachers adapt to each child, and children learn from one another while progressing at their own pace.' },
  { title: 'Curiosity of their own', text: 'Children are given the freedom to follow what interests them, so the motivation to learn comes from within.' },
  { title: 'A safe place to learn', text: 'Every pupil is valued, and learning happens without coercion, shame or humiliation.' },
];

const team: Person[] = [
  { name: 'Ms. Sophie Lovejoy', role: 'Principal', image: '/images/team/sophie-lovejoy-2026.jpeg', position: '50% 10%' },
  { name: 'Mr Kralka', role: 'Assistant Head', image: '/images/team/mr-kralka.avif', position: 'center' },
  { name: 'Miss Hannah', role: 'EY Lead & DSL', image: '/images/team/miss-hannah.avif', position: 'center' },
];
---

<Layout title="About the school" description="Forest International School Paris is an English-language school for children aged 2-15 in Mareil-Marly, west of Paris, with daily nature-based forest learning.">
  <PageHero title="A school at the edge of the forest" kicker="Mareil-Marly · Forêt de Marly · Since 2003" image={{ src: '/images/hero-banner.jpg', width: 1920, height: 1080, position: '70% 40%' }}>
    <Fragment slot="intro">An English-language school for children aged 2–15, a short distance from <span class="place">Saint-Germain-en-Laye</span>, where learning moves between the classroom and the Forêt de Marly.</Fragment>
    <a href="/contact/" class="btn-gold">Book a visit <ArrowRight size={18} aria-hidden="true" /></a>
    <a href="#approach" class="link-on-dark">How we teach <ArrowRight size={18} aria-hidden="true" /></a>
  </PageHero>

  <section class="page-section" aria-labelledby="story-title">
    <div class="container-main split-layout">
      <div class="prose-copy">
        <h2 id="story-title">Twenty years of learning outdoors</h2>
        <p class="lead-copy">Forest International School Paris sits within the boundary of the historic Forêt de Marly, west of Paris.</p>
        <p>Since 2003, we have taught through projects, and for over twenty years we have been part of the Forest School movement.</p>
        <p>Children aged 2 to 15 follow the English National Curriculum, delivered through the Pearson iPrimary programme, and learn through exploration, creativity and direct contact with nature.</p>
      </div>
      <div class="glance" aria-labelledby="glance-title">
        <h2 id="glance-title">The school at a glance</h2>
        <dl class="fact-list">
          <div><dt>Founded</dt><dd>2003</dd></div>
          <div>
            <dt>Ages</dt>
            <dd>
              <ul class="glance-programmes">
                {programmeLinks.map((link) => <li><a href={link.href}>{link.label}</a> <span>{link.detail?.replace('Ages ', '')}</span></li>)}
              </ul>
            </dd>
          </div>
          <div><dt>Curriculum</dt><dd>English National Curriculum, delivered through Pearson iPrimary</dd></div>
          <div><dt>Early Years</dt><dd>Montessori principles for autonomy and the Reggio Emilia play-based approach</dd></div>
          <div><dt>Languages</dt><dd>Taught in English, with French every day: as a foreign language (FLE) for non-francophones and following the French curriculum for native speakers</dd></div>
          <div><dt>Class size</dt><dd>Up to 15 pupils, in mixed-age groups</dd></div>
          <div><dt>Location</dt><dd>Mareil-Marly, near <span class="place">Saint-Germain-en-Laye</span></dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section id="approach" class="page-section surface" aria-labelledby="approach-title">
    <div class="container-main split-layout">
      <div class="approach-intro prose-copy">
        <h2 id="approach-title">How we teach</h2>
        <p>The ideas that shape a day at Forest, from the first year of nursery to the last year of middle school.</p>
        <img src="/images/outdoor-learning.jpg" alt="Pupils in school uniform holding large drawings on a lawn" width="1024" height="768" loading="lazy" />
      </div>
      <dl class="row-list">
        {approach.map((item) => <div><dt>{item.title}</dt><dd>{item.text}</dd></div>)}
      </dl>
    </div>
  </section>

  <section class="page-section" aria-labelledby="campus-title">
    <div class="container-main">
      <h2 id="campus-title">Around the campus</h2>
      <div class="campus-grid">
        <figure class="campus-forest">
          <img src="/images/gallery-2.jpg" alt="Young children exploring a fallen tree in the forest" width="1600" height="1067" loading="lazy" />
          <figcaption><strong>Forest and gardens</strong> Large outdoor spaces for nature-based learning.</figcaption>
        </figure>
        <figure>
          <img src="/images/school-life/swimming-pool.jpg" alt="The covered swimming pool at Forest" width="848" height="480" loading="lazy" />
          <figcaption><strong>Indoor swimming pool</strong> Heated, for swimming lessons from April to November.</figcaption>
        </figure>
        <figure>
          <img src="/images/school-life/classroom.jpg" alt="Children working together around a classroom table" width="848" height="480" loading="lazy" />
          <figcaption><strong>Classrooms and library</strong> Interactive whiteboards and computers, and a library with books in English, French and Dutch.</figcaption>
        </figure>
      </div>
      <div id="school-3d" class="street-view">
        <div class="street-view-copy">
          <h3>Look around before you visit</h3>
          <p>Walk through the school grounds in Street View.</p>
          <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="text-link">Open in Google Maps <ArrowUpRight size={18} aria-hidden="true" /><span class="sr-only"> (opens in a new tab)</span></a>
        </div>
        <div class="street-view-frame">
          <iframe title="Explore the Forest International School campus" src="https://www.google.com/maps/embed?pb=!4v1775085848328!6m8!1m7!1sCAoSF0NJSE0wb2dLRUlDQWdJQ20zZWk2eEFF!2m2!1d48.87457436890278!2d2.06500659414459!3f160!4f0!5f0.7820865974627469" width="100%" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
      </div>
    </div>
  </section>

  <section class="page-section surface" aria-labelledby="team-title">
    <div class="container-main team-layout">
      <div class="prose-copy">
        <h2 id="team-title">Meet our teachers</h2>
        <p>Get to know the teachers at Forest, from Early Years to Middle School.</p>
        <a href="/team/" class="text-link">Meet the full team <ArrowRight size={18} aria-hidden="true" /></a>
      </div>
      <PortraitList people={team} />
    </div>
  </section>

  <VisitBand title="Come and see the school">
    <p>Fill out our enquiry form and our admissions team will contact you within 24–48 hours to schedule a visit.</p>
    <p class="visit-note">No commitment required. Personal campus tours available.</p>
    <Fragment slot="actions">
      <a href={enquiryUrl} target="_blank" rel="noopener noreferrer" class="btn-gold">Make an enquiry <ArrowUpRight size={18} aria-hidden="true" /><span class="sr-only"> (opens in a new tab)</span></a>
      <a href="/admissions/" class="link-on-dark">How to apply <ArrowRight size={18} aria-hidden="true" /></a>
    </Fragment>
  </VisitBand>
</Layout>

<style>
  .glance-programmes { display: grid; gap: .25rem; }
  .glance-programmes a:hover { color: var(--color-forest-dark); }
  .glance-programmes span { color: var(--color-text-muted); }

  .approach-intro img { width: 100%; aspect-ratio: 4/3; object-fit: cover; border-radius: var(--radius-media); margin-top: 2rem; }

  .campus-grid { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); grid-template-rows: auto auto; gap: 1.5rem 2rem; margin-top: 2.5rem; }
  .campus-grid figure { min-width: 0; }
  .campus-forest { grid-row: span 2; }
  .campus-grid img { width: 100%; aspect-ratio: 2.1/1; object-fit: cover; object-position: top; border-radius: var(--radius-media); }
  .campus-forest img { aspect-ratio: auto; height: calc(100% - 4.5rem); min-height: 20rem; object-position: center; }
  .campus-grid figcaption { margin-top: .875rem; max-width: 52ch; font-size: .9375rem; line-height: 1.6; color: var(--color-text-muted); }
  .campus-grid figcaption strong { display: block; margin-bottom: .125rem; font-size: 1rem; color: var(--color-forest-dark); }
  .street-view { display: grid; grid-template-columns: minmax(0, .6fr) minmax(0, 1.4fr); gap: clamp(1.5rem, 4vw, 3rem); align-items: center; margin-top: clamp(3rem, 6vw, 4.5rem); padding-top: clamp(2rem, 4vw, 3rem); border-top: 1px solid var(--color-line); }
  .street-view h3 { font-size: 1.5rem; line-height: 1.3; color: var(--color-forest-dark); margin-bottom: .5rem; }
  .street-view .text-link { margin-top: 1rem; }
  .street-view-frame { overflow: hidden; border-radius: var(--radius-media); background: var(--color-surface); }
  .street-view-frame iframe { display: block; }

  .team-layout { display: grid; grid-template-columns: .8fr 1.5fr; align-items: center; gap: 3rem; }
  .team-layout .text-link { margin-top: 1.5rem; }

  @media (max-width: 900px) {
    .team-layout, .street-view { grid-template-columns: 1fr; }
    .approach-intro { display: grid; grid-template-columns: 1fr 1fr; gap: 0 2rem; align-items: start; }
    .approach-intro h2 { grid-column: 1 / -1; }
    .approach-intro img { margin-top: 0; }
  }
  @media (max-width: 640px) {
    .street-view-frame iframe { height: 20rem; }
    .approach-intro { grid-template-columns: 1fr; }
    .approach-intro img { margin-top: 1.5rem; }
    .campus-grid { grid-template-columns: 1fr; }
    .campus-forest { grid-row: auto; }
    .campus-forest img { height: auto; min-height: 0; aspect-ratio: 3/2; }
  }
</style>
