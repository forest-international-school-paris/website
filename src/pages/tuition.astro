---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import VisitBand from '../components/VisitBand.astro';
import { ArrowDown, ArrowRight } from '@lucide/astro';

/** A fee cell: the standard amount, then the employer-covered amount (marked *) where one applies. `null` = not applicable. */
type FeeCell = readonly string[] | null;

interface FeeRow {
  section: string;
  group?: { name: string; detail: string };
  fees: readonly FeeCell[];
}

const feeColumns = [
  { label: 'Application fee' },
  { label: 'Re-enrolment fee' },
  { label: 'FLE / EAL / LSS' },
  { label: 'Annual tuition', note: '(excludes other fees)' },
  { label: 'Development fee' },
  { label: 'Cantine fee**' },
  { label: 'Wednesday MasterClass', note: '(Externals only)' },
];

const applicationFee = ['500 €', '750 €*'];
const reenrolmentFee = ['350 €', '500 €*'];
const languageSupportFee = ['7,000 €', '12,000 €*'];
const developmentFee = ['2,500 €', '7,500 €*'];
const cantineFee = ['2,500 €', '2,500 €*'];

const feeRows: FeeRow[] = [
  {
    section: 'Nursery',
    group: { name: 'Early Years', detail: 'Nursery and Pre-School' },
    fees: [['0 €', '500 €*'], ['0 €', '500 €*'], null, ['12,500 €', '18,000 €*'], developmentFee, cantineFee, null],
  },
  { section: 'Pre-School', fees: [applicationFee, reenrolmentFee, null, ['15,000 €', '19,500 €*'], developmentFee, cantineFee, ['3,500 €']] },
  { section: 'Lower Primary', fees: [applicationFee, reenrolmentFee, languageSupportFee, ['17,500 €', '23,000 €*'], developmentFee, cantineFee, ['4,100 €']] },
  { section: 'Upper Primary', fees: [applicationFee, reenrolmentFee, languageSupportFee, ['19,000 €', '25,500 €*'], developmentFee, cantineFee, ['4,500 €']] },
  { section: 'Middle School', fees: [applicationFee, reenrolmentFee, languageSupportFee, ['23,000 €', '28,500 €*'], developmentFee, cantineFee, ['5,500 €']] },
];

const feeTypes = [
  { title: 'Enrolment fee', text: "The enrolment fee is a non-refundable fee required to secure a child's spot for the school year. It is payable upon formal acceptance of a place at the school." },
  { title: 'Tuition fee', text: 'The annual tuition fee covers curriculum, classroom resources, books, forest activities and operational expenses. Payment plans and scholarships are available based on financial assessment. Children who join during the school year pay tuition pro rata to the time remaining, and a reduction may be possible.' },
  { title: 'Development fee', text: 'The development fee is for all students. It supports the growth of our campus and enhances school-wide programmes and activities.' },
];

const extras = [
  { title: 'Breakfast club', detail: 'Monday to Friday, 08:00–08:45', price: '170 €', unit: 'per term' },
  { title: 'After-school clubs', detail: 'Monday to Friday, 16:00–17:00', price: '170 €', unit: 'per term' },
  { title: 'Bus service', detail: 'Door-to-door service', price: '4,850–9,850 €', unit: 'Depending on location' },
  { title: 'Annual school trip', detail: 'One trip per school year for primary and middle school students', price: '750 €', unit: 'per year' },
];
---

<Layout title="Tuition Fees" description="Annual tuition fees for Forest International School Paris, Nursery to Middle School, on one page: what each fee covers, with payment plans and scholarships.">
  <PageHero title="Fees at Forest International" kicker="Nursery to Middle School · Annual fees in euros">
    <Fragment slot="intro">Each charge for each school section, set out in one table. Payment plans and scholarships are available based on financial assessment.</Fragment>
    <a href="#fees" class="btn-gold">See the fees <ArrowDown size={18} aria-hidden="true" /></a>
    <a href="/contact/" class="link-on-dark">Book a visit <ArrowRight size={18} aria-hidden="true" /></a>
  </PageHero>

  <section id="fees" class="page-section" aria-labelledby="fees-title">
    <div class="container-main">
      <div class="prose-copy fees-intro">
        <h2 id="fees-title">Fees by school section</h2>
        <p>Each column shows a separate charge. Annual tuition is not the total annual cost; application or re-enrolment, development, cantine and support fees are listed separately and apply where relevant.</p>
        <p>Where a cell shows two amounts, the second, marked *, is the employer-covered fee.</p>
      </div>

      <p id="fees-scroll-hint" class="fees-scroll-hint">Swipe to see all fees, or focus the table and use the left and right arrow keys.</p>
      <div class="fees-scroll" role="region" aria-labelledby="fees-title" aria-describedby="fees-scroll-hint" tabindex="0">
        <table class="fees-table">
          <caption class="sr-only">Tuition fees by school section. Employer-covered fees are marked with an asterisk.</caption>
          <thead>
            <tr>
              <th scope="col">Section</th>
              {feeColumns.map((column) => (
                <th scope="col">{column.label}{column.note && <><br /><span class="th-note">{column.note}</span></>}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {feeRows.map((row) => (
              <>
                {row.group && (
                  <tr class="fees-group">
                    <th colspan={feeColumns.length + 1}>
                      <span class="group-label"><strong>{row.group.name}</strong> <span>{row.group.detail}</span></span>
                    </th>
                  </tr>
                )}
                <tr>
                  <th scope="row">{row.section}</th>
                  {row.fees.map((cell) => (
                    <td>
                      {cell
                        ? cell.map((amount, i) => <span class:list={['amount', { 'amount-employer': i > 0 }]}>{amount}</span>)
                        : <span class="amount amount-none">N/A</span>}
                    </td>
                  ))}
                </tr>
              </>
            ))}
          </tbody>
        </table>
      </div>

      <dl class="fees-notes">
        <div><dt>*Employer-covered fees:</dt> <dd>Charged at the full, non-discounted rate benchmarked for international organisations in France.</dd></div>
        <div><dt>**Cantine fee:</dt> <dd>Includes organic lunches and snacks. There is no charge for children wishing to bring a lunch box.</dd></div>
      </dl>
    </div>
  </section>

  <section class="page-section surface" aria-labelledby="fee-types-title">
    <div class="container-main split-layout">
      <h2 id="fee-types-title">What each fee is for</h2>
      <dl class="row-list">
        {feeTypes.map((item) => <div><dt>{item.title}</dt><dd>{item.text}</dd></div>)}
      </dl>
    </div>
  </section>

  <section class="page-section" aria-labelledby="extras-title">
    <div class="container-main split-layout">
      <div class="prose-copy">
        <h2 id="extras-title">Additional fees</h2>
        <p>Optional extras, and support for children with additional needs.</p>
      </div>
      <div>
        <dl class="extras-list">
          {extras.map((item) => (
            <div>
              <dt>{item.title}</dt>
              <dd class="extra-detail">{item.detail}</dd>
              <dd class="extra-price"><strong>{item.price}</strong> <span>{item.unit}</span></dd>
            </div>
          ))}
        </dl>
        <div class="sen-note">
          <h3>SEN support (special educational needs)</h3>
          <p>We enrol children with additional needs on a case-by-case basis and offer specialised support as needed, with additional charges. Please request the "SEN Support Fees" document for details.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="page-section surface" aria-labelledby="assistance-title">
    <div class="container-main assistance-layout">
      <div class="prose-copy">
        <h2 id="assistance-title">Financial assistance</h2>
        <p>Payment plans and scholarships are available based on financial assessment.</p>
      </div>
      <img src="/images/inst_savio.png" alt="SAVIO Education" width="362" height="242" loading="lazy" decoding="async" class="savio-logo" />
    </div>
  </section>

  <VisitBand title="Talk to us about fees">
    <p>Schedule a visit to see our campus and discuss tuition options with our admissions team.</p>
    <Fragment slot="actions">
      <a href="/contact/" class="btn-gold">Book a visit <ArrowRight size={18} aria-hidden="true" /></a>
      <a href="/admissions/" class="link-on-dark">Make an enquiry <ArrowRight size={18} aria-hidden="true" /></a>
    </Fragment>
  </VisitBand>
</Layout>

<style>
  .fees-intro { margin-bottom: 2rem; }

  /* Fee table: global .fees-* rules supply the accessible structure; these refine the look. */
  .fees-scroll { background: white; }
  .fees-table thead th { vertical-align: bottom; line-height: 1.4; }
  .fees-table thead th:first-child { position: sticky; left: 0; z-index: 2; }
  .th-note { font-weight: 400; color: var(--color-line); }
  .fees-table tbody th[scope="row"] { font-weight: 600; color: var(--color-forest-dark); }
  .group-label { position: sticky; left: 1rem; display: inline-flex; flex-wrap: wrap; gap: .25rem .75rem; align-items: baseline; }
  .group-label strong { color: var(--color-forest-dark); }
  .group-label span { font-size: .875rem; font-weight: 400; color: var(--color-text-muted); }
  .amount { display: block; font-weight: 600; color: var(--color-forest-dark); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .amount-employer { margin-top: .25rem; font-size: .875rem; font-weight: 500; color: var(--color-gold-ink); }
  .amount-none { color: var(--color-text-muted); }

  .fees-notes { display: grid; gap: .5rem; margin-top: 1.5rem; font-size: .9375rem; line-height: 1.6; color: var(--color-text-muted); }
  .fees-notes > div { max-width: 75ch; }
  .fees-notes :is(dt, dd) { display: inline; }
  .fees-notes dt { font-weight: 600; color: var(--color-text); }

  .extras-list > div { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: .25rem 2rem; padding-block: 1.25rem; border-bottom: 1px solid var(--color-line); }
  .extras-list > :first-child { padding-top: 0; }
  .extras-list dt { grid-column: 1; font-family: 'Playfair Display', Georgia, serif; font-size: clamp(1.25rem, 1.8vw, 1.5rem); line-height: 1.3; color: var(--color-forest-dark); }
  .extra-detail { grid-column: 1; line-height: 1.6; color: var(--color-text-muted); }
  .extra-price { grid-column: 2; grid-row: 1 / span 2; text-align: right; line-height: 1.4; }
  .extra-price strong { display: block; font-size: 1.25rem; font-weight: 600; color: var(--color-forest-green); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .extra-price span { font-size: .875rem; color: var(--color-text-muted); }
  .sen-note { margin-top: 2rem; padding: clamp(1.25rem, 3vw, 1.75rem); border-radius: var(--radius-media); background: var(--color-surface); }
  .sen-note h3 { font-size: 1.25rem; line-height: 1.3; margin-bottom: .5rem; }
  .sen-note p { max-width: 60ch; line-height: 1.75; }

  .assistance-layout { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 2rem 4rem; }
  .assistance-layout h2 { margin-bottom: .75rem; }
  .savio-logo { width: min(100%, 15rem); height: auto; padding: 1rem; border-radius: var(--radius-media); background: white; }

  @media (max-width: 640px) {
    .extras-list > div { grid-template-columns: 1fr; }
    .extra-price { grid-column: 1; grid-row: auto; text-align: left; margin-top: .25rem; }
    .extra-price strong { display: inline; }
  }
</style>
