---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import VisitBand from '../components/VisitBand.astro';
import { ArrowRight } from '@lucide/astro';
import { programmeLinks } from '../lib/site';

const currentPath = '/early-years/';
const otherProgrammes = programmeLinks.filter((link) => link.href !== currentPath);

const learning = [
  { title: 'Specialist teachers', text: 'In addition to the class teacher, children have visits from specialist teachers for Music, Sport and French.' },
  { title: 'French every week', text: 'Children have 4.5 hours of immersive French each week. Language learning focuses on fun, discovery and communication.' },
  { title: 'Part of the whole school', text: 'Even the youngest children join assemblies, themed days and school trips, which makes their move up through the school easier.' },
  { title: 'In the forest every day', text: 'Daily forest activities, where children learn through exploration and discovery.' },
];
---

<Layout title="English Preschool near Paris" description="Nursery and preschool in English for children aged 2-5, with daily forest time on our campus in Mareil-Marly, west of Paris.">
  <PageHero title="Early Years" kicker="Ages 2–5 · Nursery and Pre-School" image={{ src: '/images/gallery-2.jpg', width: 1600, height: 1067, position: '65% 45%' }}>
    <Fragment slot="intro">Project-based play and collaborative exploration, in English, with daily forest time on our campus in Mareil-Marly, near <span class="place">Saint-Germain-en-Laye</span>.</Fragment>
    <a href="/contact/" class="btn-gold">Book a visit <ArrowRight size={18} aria-hidden="true" /></a>
    <a href="/tuition/" class="link-on-dark">Nursery and Pre-School fees <ArrowRight size={18} aria-hidden="true" /></a>
  </PageHero>

  <section class="page-section" aria-labelledby="overview-title">
    <div class="container-main split-layout">
      <div class="prose-copy">
        <h2 id="overview-title">Two groups, from age 2 to 5</h2>
        <p class="lead-copy">Early Years at Forest is for children aged 2 to 5, and is built on project-based play and collaborative exploration.</p>
        <p>It has two sections, Nursery for 2 to 4 year olds and Pre-School for 4 to 5 year olds, so that children feel supported as they grow.</p>
        <p>Children may attend for half or full days. We recommend at least three half days a week, so that they benefit fully from the programme.</p>
      </div>
      <div class="glance" aria-labelledby="glance-title">
        <h2 id="glance-title">Early Years at a glance</h2>
        <dl class="fact-list">
          <div><dt>Nursery</dt><dd>2–4 years old</dd></div>
          <div><dt>Pre-School</dt><dd>4–5 years old</dd></div>
          <div><dt>Class size</dt><dd>Maximum 5 children in the younger group, 11 in the older group</dd></div>
          <div><dt>Attendance</dt><dd>Half or full days, with a minimum of three half days recommended</dd></div>
          <div><dt>French</dt><dd>4.5 hours per week</dd></div>
          <div><dt>Fees</dt><dd><a href="/tuition/">See current Nursery and Pre-School fees</a></dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section class="page-section surface" aria-labelledby="learning-title">
    <div class="container-main split-layout">
      <div class="learning-intro prose-copy">
        <h2 id="learning-title">What children learn</h2>
        <p>The Early Years curriculum builds on what each child already knows and opens up new ways to learn.</p>
        <img src="/images/forest-walk.jpg" alt="Five young children in school uniform carrying a long branch together along a leaf-covered forest path" width="336" height="303" loading="lazy" decoding="async" class="media-rounded" />
      </div>
      <dl class="row-list">
        {learning.map((item) => <div><dt>{item.title}</dt><dd>{item.text}</dd></div>)}
      </dl>
    </div>
  </section>

  <section class="page-section" aria-labelledby="next-title">
    <div class="container-main split-layout">
      <div class="prose-copy">
        <h2 id="next-title">Other age groups and holiday camps</h2>
        <p>Full fees are on the tuition page. Primary shows what comes next, and the holiday camps are an easy first taste of Forest.</p>
      </div>
      <dl class="fact-list">
        {otherProgrammes.map((link) => <div><dt><a href={link.href}>{link.label}</a></dt><dd>{link.detail}</dd></div>)}
        <div><dt><a href="/holiday-camps/">Holiday camps</a></dt><dd>An easy first taste of Forest</dd></div>
        <div><dt><a href="/tuition/">Tuition</a></dt><dd>Full fees for Nursery and Pre-School</dd></div>
      </dl>
    </div>
  </section>

  <VisitBand title="Come and see Early Years">
    <p>Contact us to learn more about our Early Years programme and to arrange a visit.</p>
    <Fragment slot="actions">
      <a href="/contact/" class="btn-gold">Book a visit <ArrowRight size={18} aria-hidden="true" /></a>
      <a href="/admissions/" class="link-on-dark">How to apply <ArrowRight size={18} aria-hidden="true" /></a>
    </Fragment>
  </VisitBand>
</Layout>

<style>
  .learning-intro img { max-width: 21rem; margin-top: 2rem; }
</style>
