---
import CalendarButton from '../../components/CalendarButton.astro';
import Layout from '../../layouts/Layout.astro';
import { openHouse, school, eventDate, eventDay, eventTime, directionsUrl } from '../../lib/open-house';
import { CalendarDays, MapPin, ArrowUpRight } from '@lucide/astro';
const changeUrl = `mailto:${school.email}?subject=${encodeURIComponent('Open House — change of plans')}`;
---

<Layout title="Thank you for registering — Open House" description="Save your Open House visit to your calendar, find the school and plan your journey." noindex={true} showPopup={false}>
  <section class="visit-intro">
    <div class="container-main intro-layout">
      <div class="intro-copy">
        <p class="occasion">{openHouse.title}</p>
        <h1>Thank you for registering.</h1>
        <p class="intro-text">Add your visit to your calendar.</p>
        <div class="event-details">
          <CalendarDays size={23} aria-hidden="true" />
          <div><strong>{eventDay}, {eventDate}</strong><p>{eventTime} <span>· Paris time</span></p></div>
        </div>
        <div class="calendar-actions" aria-label="Save the event to your calendar">
          <CalendarButton id="confirmation-calendar" />
        </div>
      </div>
      <figure class="campus-photo">
        <img src="/images/campus-hero-960.webp" width="1829" height="713" alt="The school building and garden beside the forest in Mareil-Marly" fetchpriority="high" />
      </figure>
    </div>
  </section>

  <div class="container-main visit-body">
    <section class="arrival" aria-labelledby="arrival-title">
      <h2 id="arrival-title">Getting here</h2>
      <div class="address-line"><MapPin size={22} aria-hidden="true" /><address>{school.address}</address></div>
      <a class="text-link" href={directionsUrl} target="_blank" rel="noopener noreferrer">Get directions <ArrowUpRight size={18} aria-hidden="true" /></a>
    </section>
    <section class="parking" aria-labelledby="parking-title">
      <h2 id="parking-title">Parking</h2>
      <p>{openHouse.parkingNote}</p>
      <a class="text-link" href={openHouse.parkingUrl} target="_blank" rel="noopener noreferrer">View nearby car park <ArrowUpRight size={18} aria-hidden="true" /></a>
    </section>
    <p class="change-plans">Plans changed? <a href={changeUrl}>Contact us to cancel or arrange another visit.</a></p>
  </div>
</Layout>

<style>
  .visit-intro { background: var(--color-forest-dark); color: white; }
  .intro-layout { display: grid; grid-template-columns: 1.2fr 1fr; gap: clamp(2rem, 5vw, 4.5rem); padding-block: clamp(2.5rem, 5vw, 4.5rem); align-items: center; }
  .occasion { color: var(--color-gold); font-weight: 600; margin-bottom: 1rem; }
  h1 { font-size: clamp(2.3rem, 4vw, 3.6rem); font-weight: 400; line-height: 1.12; letter-spacing: -.025em; text-wrap: balance; }
  .intro-text { margin-top: 1.3rem; max-width: 45ch; line-height: 1.7; color: white; }
  .event-details { display: flex; gap: .9rem; margin-top: 2rem; align-items: start; }
  .event-details strong { font-size: 1.15rem; }
  .event-details p { margin-top: .35rem; line-height: 1.6; }
  .event-details span { white-space: nowrap; }
  .calendar-actions { display: flex; align-items: start; flex-direction: column; gap: .65rem; margin-top: 1.5rem; }
  .campus-photo { margin: 0; }
  .campus-photo img { width: 100%; height: 300px; object-fit: cover; object-position: 66% center; border-radius: var(--radius-media); }
  .visit-body { display: grid; grid-template-columns: 1.2fr 1fr; gap: clamp(2rem, 5vw, 4.5rem); padding-block: 2.5rem 3rem; color: var(--color-text); }
  h2 { font-size: clamp(1.7rem, 3vw, 2.2rem); color: var(--color-forest-dark); margin-bottom: 1.5rem; font-weight: 400; }
  .visit-body p { line-height: 1.75; max-width: 55ch; }
  .address-line { display: flex; gap: .75rem; align-items: start; margin-bottom: 1.5rem; }
  .address-line svg, .event-details svg { flex-shrink: 0; margin-top: .15rem; }
  address { font-style: normal; line-height: 1.7; }
  .change-plans { grid-column: 1 / -1; font-size: .95rem; }
  .change-plans a { text-decoration: underline; text-underline-offset: 3px; }
  .text-link { margin-top: 1rem; }
  @media (max-width: 760px) {
    .intro-layout, .visit-body { grid-template-columns: 1fr; }
    .campus-photo { display: none; }
    .visit-body { padding-bottom: 7rem; }
  }
</style>
