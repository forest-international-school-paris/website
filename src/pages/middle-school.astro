---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import VisitBand from '../components/VisitBand.astro';
import { ArrowRight } from '@lucide/astro';
import { programmeLinks } from '../lib/site';

const currentPath = '/middle-school/';
const otherProgrammes = programmeLinks.filter((link) => link.href !== currentPath);

const skills = [
  { title: 'Independent thinking', text: 'Helping children become independent thinkers who solve problems by asking questions.' },
  { title: 'Critical thinking', text: 'Critical thinking skills developed through project-based learning and real-world applications.' },
  { title: 'Literacy, numeracy and communication', text: 'Developing the literacy, numeracy and communication skills pupils will need later on.' },
  { title: 'French and English', text: '6.5 hours of French lessons each week, with constant use of English, building confidence through reading and speaking.' },
  { title: 'Technology', text: 'All Middle School pupils learn to use a wide range of technologies to present their work.' },
  { title: 'Resilience and creativity', text: 'Pupils grow in resilience, creativity and curiosity.' },
];
---

<Layout title="International Middle School near Paris" description="International middle school for ages 11-15 in Mareil-Marly, west of Paris — English National Curriculum and IMYC, project-based and rooted in the forest.">
  <PageHero title="Middle School" kicker="Ages 11–15 · English National Curriculum and IMYC">
    <Fragment slot="intro">Helping children become independent thinkers, in an English-language middle school on our forest campus in Mareil-Marly, west of Paris.</Fragment>
    <a href="/contact/" class="btn-gold">Book a visit <ArrowRight size={18} aria-hidden="true" /></a>
    <a href="/tuition/" class="link-on-dark">Middle School fees <ArrowRight size={18} aria-hidden="true" /></a>
  </PageHero>

  <section class="page-section" aria-labelledby="overview-title">
    <div class="container-main split-layout">
      <div class="prose-copy">
        <h2 id="overview-title">Learning to think independently</h2>
        <p class="lead-copy">Middle School is for pupils aged 11 to 15, and focuses on helping children become independent thinkers.</p>
        <p>It is designed to inspire pupils and develop their critical thinking skills.</p>
        <p>Teaching combines the English National Curriculum with the International Middle Years Curriculum (IMYC), covering science, history, geography, arts and music through thematic learning units.</p>
        <p>Pupils build on the foundations laid from Key Stage 1, with structured, project-based lessons in which the forest plays a large part.</p>
      </div>
      <div class="glance" aria-labelledby="glance-title">
        <h2 id="glance-title">Middle School at a glance</h2>
        <dl class="fact-list">
          <div><dt>Age range</dt><dd>11–15 years old</dd></div>
          <div><dt>Curriculum</dt><dd>English National Curriculum and International Middle Years Curriculum</dd></div>
          <div><dt>French</dt><dd>6.5 hours per week</dd></div>
          <div><dt>Technology</dt><dd>A wide range of technologies, used to present work</dd></div>
          <div><dt>Fees</dt><dd><a href="/tuition/">See current Middle School fees</a></dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section class="page-section surface" aria-labelledby="skills-title">
    <div class="container-main split-layout">
      <div class="skills-intro prose-copy">
        <h2 id="skills-title">The skills we work on</h2>
        <p>Middle School develops the skills and habits pupils need for secondary education and beyond.</p>
        <img src="/images/school-life/classroom.jpg" alt="Pupils working on drawings together around a classroom table" width="848" height="480" loading="lazy" decoding="async" class="media-rounded film-still" />
      </div>
      <dl class="row-list">
        {skills.map((item) => <div><dt>{item.title}</dt><dd>{item.text}</dd></div>)}
      </dl>
    </div>
  </section>

  <section class="page-section" aria-labelledby="next-title">
    <div class="container-main split-layout">
      <div class="prose-copy">
        <h2 id="next-title">Brothers, sisters and holiday camps</h2>
        <p>Full fees are on the tuition page. Younger siblings are welcome in Early Years and Primary, and our holiday camps are open to all children aged 2–12.</p>
      </div>
      <dl class="fact-list">
        {otherProgrammes.map((link) => <div><dt><a href={link.href}>{link.label}</a></dt><dd>{link.detail}, for younger siblings</dd></div>)}
        <div><dt><a href="/holiday-camps/">Holiday camps</a></dt><dd>Open to all children aged 2–12</dd></div>
        <div><dt><a href="/tuition/">Tuition</a></dt><dd>Full fees for Middle School</dd></div>
      </dl>
    </div>
  </section>

  <VisitBand title="Come and see Middle School">
    <p>Contact us to learn more about our Middle School programme and to arrange a visit.</p>
    <Fragment slot="actions">
      <a href="/contact/" class="btn-gold">Book a visit <ArrowRight size={18} aria-hidden="true" /></a>
      <a href="/admissions/" class="link-on-dark">How to apply <ArrowRight size={18} aria-hidden="true" /></a>
    </Fragment>
  </VisitBand>
</Layout>

<style>
  .skills-intro img { margin-top: 2rem; }
</style>
