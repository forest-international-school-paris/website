---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import VisitBand from '../components/VisitBand.astro';
import { ArrowRight } from '@lucide/astro';
import { programmeLinks } from '../lib/site';

const currentPath = '/primary/';
const otherProgrammes = programmeLinks.filter((link) => link.href !== currentPath);

const schoolWeek = [
  { title: 'Multi-level classes', text: 'Classes are multi-level, with one teacher, and at least one or more teaching assistants for the younger classes.' },
  { title: 'Special needs support', text: 'Highly qualified Special Needs assistance is available if required, for children with ADHD, dyslexia and other conditions.' },
  { title: 'Technology', text: 'All classrooms have interactive whiteboards, and computers for individual work. Programming is taught in Primary.' },
  { title: 'Swimming', text: 'Qualified sports teachers give swimming lessons twice a week in our heated pool on campus.' },
  { title: 'Languages', text: 'ESL is available, and French is taught as a foreign language or for native speakers, with preparation for Alliance Française tests.' },
  { title: 'Outdoors', text: 'Biking and long tours in the forest in spring, and swimming in summer and autumn.' },
];
---

<Layout title="English Primary School near Paris" description="English primary school for children aged 6-11 near Saint-Germain-en-Laye, west of Paris — English National Curriculum plus IPC on our forest campus.">
  <PageHero title="Primary School" kicker="Ages 6–11 · English National Curriculum and IPC" image={{ src: '/images/school-film-20-5s.jpg', width: 1920, height: 1080, position: '60% 40%' }}>
    <Fragment slot="intro">The English National Curriculum combined with the International Primary Curriculum, taught in English on our forest campus in Mareil-Marly, west of Paris.</Fragment>
    <a href="/contact/" class="btn-gold">Book a visit <ArrowRight size={18} aria-hidden="true" /></a>
    <a href="/tuition/" class="link-on-dark">Primary fees <ArrowRight size={18} aria-hidden="true" /></a>
  </PageHero>

  <section class="page-section" aria-labelledby="overview-title">
    <div class="container-main split-layout">
      <div class="prose-copy">
        <h2 id="overview-title">One class teacher, two curricula</h2>
        <p class="lead-copy">For children aged 6 to 11, each child has a class teacher who teaches all academic subjects.</p>
        <p>We focus on the social and learning development of each child.</p>
        <p>Teaching combines two recognised programmes: the English National Curriculum (ENC) and the International Primary Curriculum (IPC). The IPC covers science, history, geography, arts and music through thematic learning units.</p>
      </div>
      <div class="glance" aria-labelledby="glance-title">
        <h2 id="glance-title">Primary at a glance</h2>
        <dl class="fact-list">
          <div><dt>Age range</dt><dd>6–11 years old</dd></div>
          <div><dt>Class size</dt><dd>Maximum 15 pupils</dd></div>
          <div><dt>Curriculum</dt><dd>English National Curriculum and International Primary Curriculum</dd></div>
          <div><dt>Languages</dt><dd>English and French</dd></div>
          <div><dt>Swimming</dt><dd>Twice a week, in the heated pool on campus</dd></div>
          <div><dt>Fees</dt><dd><a href="/tuition/">See current Primary fees</a></dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section class="page-section surface" aria-labelledby="week-title">
    <div class="container-main split-layout">
      <div class="week-intro prose-copy">
        <h2 id="week-title">Classes, support and the week</h2>
        <p>How Primary classes are staffed, the support available, and what children do beyond the classroom.</p>
        <img src="/images/school-life/individual-guidance.jpg" alt="A teacher guiding a pupil wearing headphones through an exercise at a keyboard" width="848" height="480" loading="lazy" decoding="async" class="media-rounded film-still" />
      </div>
      <dl class="row-list">
        {schoolWeek.map((item) => <div><dt>{item.title}</dt><dd>{item.text}</dd></div>)}
      </dl>
    </div>
  </section>

  <section class="page-section" aria-labelledby="next-title">
    <div class="container-main split-layout">
      <div class="prose-copy">
        <h2 id="next-title">Other age groups and holiday camps</h2>
        <p>Full fees are on the tuition page. You can also explore Early Years and Middle School, or try a holiday camp first.</p>
      </div>
      <dl class="fact-list">
        {otherProgrammes.map((link) => <div><dt><a href={link.href}>{link.label}</a></dt><dd>{link.detail}</dd></div>)}
        <div><dt><a href="/holiday-camps/">Holiday camps</a></dt><dd>Try a holiday camp first</dd></div>
        <div><dt><a href="/tuition/">Tuition</a></dt><dd>Full fees for Primary</dd></div>
      </dl>
    </div>
  </section>

  <VisitBand title="Come and see Primary">
    <p>Contact us to learn more about our Primary programme and to arrange a visit.</p>
    <Fragment slot="actions">
      <a href="/contact/" class="btn-gold">Book a visit <ArrowRight size={18} aria-hidden="true" /></a>
      <a href="/admissions/" class="link-on-dark">How to apply <ArrowRight size={18} aria-hidden="true" /></a>
    </Fragment>
  </VisitBand>
</Layout>

<style>
  .week-intro img { margin-top: 2rem; }
</style>
