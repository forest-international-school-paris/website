---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import VisitBand from '../../components/VisitBand.astro';
import { ArrowRight, ArrowUpRight } from '@lucide/astro';

const alternates = [
  { hreflang: 'en', href: '/admissions/' },
  { hreflang: 'fr', href: '/fr/admissions/' },
  { hreflang: 'x-default', href: '/admissions/' },
];

const applicationUrl = 'https://docs.google.com/forms/d/e/1FAIpQLSdzobNF-7dTwJnfd8-poukuc0ICQ0o_-AAdhsxRJ2KPhg_VGA/viewform';

const steps = [
  { title: 'Déposez votre demande', text: 'Remplissez le formulaire de candidature pour manifester votre intérêt et vous inscrire à une journée portes ouvertes.' },
  { title: "Visitez l'école", text: "Visite sur place, rendez-vous en visioconférence ou journée portes ouvertes : vous rencontrez l'équipe et découvrez le campus." },
  { title: 'Constituez le dossier', text: "Si l'école correspond à votre projet, vous soumettez le dossier d'inscription avec les documents demandés." },
  { title: 'Confirmation', text: "Après acceptation, la place de votre enfant est confirmée et un membre de l'équipe admissions vous accompagne à chaque étape." },
];
---

<Layout
  title="École internationale anglophone 2-15 ans – Yvelines"
  description="École internationale anglophone à Mareil-Marly, près de Saint-Germain-en-Laye (78). Enfants de 2 à 15 ans, pédagogie par la nature. Admissions toute l'année."
  lang="fr"
  alternates={alternates}
  showPopup={false}
>
  <PageHero
    lang="fr"
    title="École internationale anglophone dans l'Ouest parisien"
    kicker="2 à 15 ans · Admissions toute l'année · Mareil-Marly (78)"
    intro="La Forest International School Paris est une école internationale anglophone installée à Mareil-Marly (Yvelines), à quelques minutes de Saint-Germain-en-Laye. Elle accueille les enfants de 2 à 15 ans, de la maternelle au collège, avec une pédagogie fondée sur la nature."
    image={{ src: '/images/children-diversity.jpg', alt: "Élèves en uniforme de l'école tenant de grands ballons dessinés sur la pelouse", width: 1024, height: 768, position: '50% 35%' }}
  >
    <a href={applicationUrl} target="_blank" rel="noopener noreferrer" class="btn-gold">Formulaire de candidature <ArrowUpRight size={18} aria-hidden="true" /><span class="sr-only"> (s'ouvre dans un nouvel onglet)</span></a>
    <a href="/contact/" class="link-on-dark">Prendre contact <ArrowRight size={18} aria-hidden="true" /></a>
  </PageHero>

  <section class="page-section" aria-labelledby="process-title">
    <div class="container-main split-layout">
      <div class="prose-copy">
        <h2 id="process-title">Comment inscrire votre enfant</h2>
        <p class="lead-copy">Les candidatures sont acceptées toute l'année.</p>
        <p>L'école ne pratique pas de liste d'attente pour les admissions : <a href="/contact/" class="inline-link">contactez-nous</a> pour connaître les places disponibles.</p>
      </div>
      <ol class="step-list">
        {steps.map((step, index) => (
          <li>
            <span class="step-number" aria-hidden="true">{index + 1}</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
              {index === 0 && (
                <a href={applicationUrl} target="_blank" rel="noopener noreferrer" class="text-link">Ouvrir le formulaire de candidature <ArrowUpRight size={18} aria-hidden="true" /><span class="sr-only"> (s'ouvre dans un nouvel onglet)</span></a>
              )}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="page-section surface" aria-labelledby="overview-title">
    <div class="container-main split-layout">
      <div class="prose-copy">
        <h2 id="overview-title">L'école en bref</h2>
        <p>Si vous comparez les écoles anglophones de maternelle et primaire dans l'Ouest parisien, consultez aussi notre <a href="/fr/news/ecole-anglaise-paris-maternelle-primaire/" class="inline-link">guide des écoles anglaises à Paris et dans les Yvelines</a>.</p>
      </div>
      <dl class="fact-list">
        <div>
          <dt>Âges accueillis</dt>
          <dd>De 2 à 15 ans : <a href="/early-years/">maternelle (2-5 ans)</a>, <a href="/primary/">primaire (6-11 ans)</a> et <a href="/middle-school/">collège (11-15 ans)</a></dd>
        </div>
        <div><dt>Programme</dt><dd>Enseignement en anglais selon l'English National Curriculum, avec le programme Pearson iPrimary</dd></div>
        <div><dt>Campus</dt><dd>Fondée en 2003, l'école pratique l'apprentissage au contact direct de la nature, sur son campus forestier de Mareil-Marly</dd></div>
        <div><dt>Journée type</dt><dd>Classe de 8h45 à 15h45, club périscolaire jusqu'à 17h, accueil tardif jusqu'à 18h</dd></div>
        <div><dt>Adresse</dt><dd>28 Rue de Tour d'Echelle, 78750 Mareil-Marly, proche de Saint-Germain-en-Laye, Marly-le-Roi et Le Vésinet</dd></div>
        <div><dt>Frais de scolarité</dt><dd>Publiés en toute transparence sur la page <a href="/tuition/">Tuition &amp; Fees</a> (en anglais)</dd></div>
      </dl>
    </div>
  </section>

  <section class="page-section" aria-labelledby="faq-title">
    <div class="container-main split-layout">
      <div class="prose-copy">
        <h2 id="faq-title">Questions fréquentes</h2>
        <p class="language-note">Le site principal de l'école est en anglais : <a href="/admissions/" lang="en" hreflang="en" class="inline-link">voir cette page en anglais</a>.</p>
      </div>
      <dl class="row-list">
        <div>
          <dt>À quels âges peut-on inscrire un enfant ?</dt>
          <dd>L'école accueille les enfants de 2 à 15 ans, répartis entre la maternelle (Early Years), le primaire et le collège (Middle School).</dd>
        </div>
        <div>
          <dt>Peut-on s'inscrire en cours d'année ?</dt>
          <dd>Oui. Les candidatures sont étudiées tout au long de l'année scolaire, sans date limite liée à l'anniversaire de l'enfant.</dd>
        </div>
        <div>
          <dt>Dans quelle langue se déroulent les cours ?</dt>
          <dd>L'enseignement est dispensé en anglais, selon l'English National Curriculum. Notre équipe répond à vos questions en français comme en anglais.</dd>
        </div>
        <div>
          <dt>Où se trouve l'école et comment y accéder ?</dt>
          <dd>Le campus est situé au 28 Rue de Tour d'Echelle à Mareil-Marly (78750), dans l'Ouest parisien, à proximité de Saint-Germain-en-Laye. Le plan d'accès figure sur la <a href="/contact/" class="inline-link">page contact</a>.</dd>
        </div>
        <div>
          <dt>Quels sont les frais de scolarité ?</dt>
          <dd>L'ensemble des tarifs est publié sur la page <a href="/tuition/" class="inline-link">Tuition &amp; Fees</a>.</dd>
        </div>
        <div>
          <dt>Proposez-vous des activités pendant les vacances scolaires ?</dt>
          <dd>Oui : des <a href="/fr/stages-vacances/" class="inline-link">stages de vacances en anglais</a> ouverts à tous les enfants de 2 à 12 ans, même non scolarisés à l'école.</dd>
        </div>
      </dl>
    </div>
  </section>

  <VisitBand title="Venez rencontrer l'école">
    <p>Contactez l'équipe admissions pour vérifier les places disponibles ou organiser une visite du campus.</p>
    <Fragment slot="actions">
      <a href="/contact/" class="btn-gold">Prendre contact <ArrowRight size={18} aria-hidden="true" /></a>
      <a href={applicationUrl} target="_blank" rel="noopener noreferrer" class="link-on-dark">Formulaire de candidature <ArrowUpRight size={18} aria-hidden="true" /><span class="sr-only"> (s'ouvre dans un nouvel onglet)</span></a>
    </Fragment>
  </VisitBand>
</Layout>

<style>
  .fact-list > div { grid-template-columns: 10rem minmax(0, 1fr); }
  .language-note { font-size: .9375rem; color: var(--color-text-muted); }

  @media (max-width: 640px) {
    .fact-list > div { grid-template-columns: 1fr; }
  }
</style>
