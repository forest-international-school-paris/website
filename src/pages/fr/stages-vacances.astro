---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionChooser from '../../components/SectionChooser.astro';
import CampList, { type Camp, type CampFact } from '../../components/CampList.astro';
import '../../styles/camps.css';
import VisitBand from '../../components/VisitBand.astro';
import { ArrowRight, ArrowUpRight } from '@lucide/astro';

const alternates = [
  { hreflang: 'en', href: '/holiday-camps/' },
  { hreflang: 'fr', href: '/fr/stages-vacances/' },
  { hreflang: 'x-default', href: '/holiday-camps/' },
];

const masterClassRegisterUrl = 'https://docs.google.com/forms/d/e/1FAIpQLSenMtdBQPV1w-LJjl6SLFV07K6GGkGf-lx760_lxrqfrFMrEA/viewform';
const bookVisitUrl = 'https://calendar.app.google/4Pur5YQjQC8tXjdj7';
const campRegisterUrl = 'https://forms.gle/6y8k9xULoLzSCt7n7';

const PHOTO_ALT = 'Photos du stage d\'été : enfants qui courent sur une pelouse, séance dans la piscine de l\'école, enfants souriants en plein air et enfant grimpé dans un arbre';

// Facts that are identical for every camp are listed once, above the schedule.
const sharedFacts: CampFact[] = [
  { label: 'Repas', value: '40 €/semaine, collations incluses' },
  { label: 'Transport', value: 'Sur demande — Saint-Germain-en-Laye, Le Pecq & Paris 16' },
];

const camps: Camp[] = [
  {
    key: 'autumn',
    season: 'Automne',
    title: 'Stage de la Toussaint',
    registerUrl: campRegisterUrl,
    description: 'Une semaine d\'automne entre nature, ateliers créatifs et exploration en plein air.',
    dates: '19 - 23 octobre 2026',
    hours: 'Tous les jours 10h00 - 16h00',
    rate: '450 €/semaine',
  },
  {
    key: 'winter',
    season: 'Hiver',
    title: 'Stage d\'hiver de février',
    registerUrl: campRegisterUrl,
    description: 'Une semaine d\'hiver avec apprentissages dans la nature, projets créatifs et activités en plein air.',
    dates: '8 - 12 février 2027',
    hours: 'Tous les jours 10h00 - 16h00',
    rate: '450 €/semaine',
  },
  {
    key: 'spring',
    season: 'Printemps',
    title: 'Stage de printemps',
    registerUrl: campRegisterUrl,
    description: 'Une semaine de printemps entre fleurs, activités ludiques et beaucoup de temps dans la nature.',
    dates: '5 - 9 avril 2027',
    hours: 'Tous les jours 10h00 - 16h00',
    rate: '450 €/semaine',
  },
  {
    key: 'summer-2027',
    season: 'Été',
    title: 'Stage d\'été 2027',
    registerUrl: 'https://forms.gle/5JfDd3U13ZTYMvK76',
    description: 'Un programme d\'activités en plein air, avec baignade dans notre piscine et temps calme en forêt, à l\'ombre des arbres.',
    sessions: { month: 'juillet 2027', weeks: ['5 - 9', '12 - 16', '19 - 23'] },
    hours: 'Tous les jours 10h00 - 17h00',
    rate: '480 €/semaine',
    extra: { label: 'Accueil anticipé / départ tardif', value: '9h00 et 18h00 — 40 €/jour' },
    photo: { src: '/images/summer-camp.jpg', alt: PHOTO_ALT, width: 572, height: 459 },
  },
];
---

<Layout
  title="Stages de vacances et ateliers du mercredi en anglais"
  description="Stages de vacances en anglais pour les enfants de 2 à 12 ans et ateliers du mercredi, sur notre campus dans la nature près de Saint-Germain-en-Laye."
  image="/images/summer-camp.jpg"
  lang="fr"
  alternates={alternates}
  showPopup={false}
>
  <PageHero kicker="Stages de vacances · Wednesday MasterClasses · Mareil-Marly" lang="fr">
    <Fragment slot="title"><span class="title-holidays">Vacances</span> <span class="title-amp">&amp;</span> <span class="title-wednesdays">mercredis</span></Fragment>
    <Fragment slot="intro">Pendant les vacances scolaires, les enfants passent leurs journées dehors et en anglais sur notre campus forestier. Les stages sont ouverts à tous les enfants de 2 à 12 ans, qu'ils soient ou non scolarisés à Forest pendant l'année. Le mercredi, les MasterClasses proposent des ateliers d'enrichissement en anglais.</Fragment>
    <a href="/contact/" class="link-on-dark">Nous contacter <ArrowRight size={18} aria-hidden="true" /></a>
    <a href="/holiday-camps/" lang="en" hreflang="en" class="link-on-dark">View this page in English</a>
    <SectionChooser slot="aside" label="Sur cette page" choices={[
      { href: '#camps', title: 'Stages de vacances', detail: "Toussaint, hiver, printemps et été · 2 à 12 ans · Ouverts à tous les enfants", action: 'Voir les dates', tone: 'gold' },
      { href: '#masterclasses', title: 'Wednesday MasterClasses', lang: 'en', detail: "Chaque mercredi · Early Years & Lower Primary · Liste d'attente uniquement", action: 'Voir les MasterClasses', tone: 'leaf' },
    ]} />
  </PageHero>

  <section id="camps" class="page-section" aria-labelledby="camps-title">
    <div class="container-main">
      <div class="camps-intro">
        <div class="prose-copy">
          <h2 id="camps-title">Dates, horaires et tarifs des stages</h2>
          <p>Le programme 2026/27, des vacances de la Toussaint à juillet.</p>
        </div>
      </div>

      <CampList camps={camps} sharedFacts={sharedFacts} labels={{ shared: "Pour tous les stages", sessions: "Semaines proposées", register: "S'inscrire", registerHint: (title) => ` : ${title} (s'ouvre dans un nouvel onglet)` }} />
    </div>
  </section>

  <section id="masterclasses" class="page-section surface" aria-labelledby="masterclasses-title">
    <div class="container-main split-layout">
      <div class="prose-copy">
        <h2 id="masterclasses-title" lang="en">Wednesday MasterClasses</h2>
        <p>Des ateliers d'enrichissement en anglais chaque mercredi, pour apprendre autrement, avec curiosité et créativité, en dehors de la classe.</p>
      </div>
      <div>
        <dl class="fact-list">
          <div><dt>Quand</dt><dd>Chaque mercredi</dd></div>
          <div><dt>Pour</dt><dd lang="en">Early Years &amp; Lower Primary</dd></div>
          <div><dt>Places</dt><dd>Liste d'attente uniquement</dd></div>
          <div><dt>Tarifs</dt><dd>Voir la colonne Wednesday MasterClass de la page <a href="/tuition/" lang="en">Tuition</a></dd></div>
        </dl>
        <div class="masterclass-actions">
          <a href={masterClassRegisterUrl} target="_blank" rel="noopener noreferrer" class="btn-primary">
            S'inscrire<span class="sr-only"> aux Wednesday MasterClasses (s'ouvre dans un nouvel onglet)</span>
            <ArrowUpRight size={18} aria-hidden="true" />
          </a>
          <a href={bookVisitUrl} target="_blank" rel="noopener noreferrer" class="text-link">
            Réserver une visite<span class="sr-only"> (s'ouvre dans un nouvel onglet)</span>
            <ArrowUpRight size={18} aria-hidden="true" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <VisitBand title="Au-delà des vacances">
    <p class="beyond-copy">
      Si votre enfant aime les stages, la vie à l'école suit le même esprit — dehors, en anglais, tous les jours. Découvrez
      <a href="/early-years/">Early Years (2–5 ans)</a>,
      <a href="/primary/">Primary School (6–11 ans)</a> et
      <a href="/middle-school/">Middle School (11–15 ans)</a>,
      consultez les <a href="/tuition/">frais de scolarité</a>,
      ou visitez la page <a href="/fr/admissions/">admissions</a> — les candidatures sont ouvertes toute l'année.
    </p>
    <Fragment slot="actions">
      <a href="/fr/admissions/" class="btn-gold">Découvrir les admissions <ArrowRight size={18} aria-hidden="true" /></a>
      <a href="/contact/" class="link-on-dark">Nous contacter <ArrowRight size={18} aria-hidden="true" /></a>
    </Fragment>
  </VisitBand>
</Layout>
