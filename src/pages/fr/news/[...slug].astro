---
import Layout from '../../../layouts/Layout.astro';
import ArticleView from '../../../components/ArticleView.astro';
import VisitBand from '../../../components/VisitBand.astro';
import { ArrowRight } from '@lucide/astro';
import { getCollection } from 'astro:content';
import { postAlternates } from '../../../lib/post-translations';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter(post => post.data.lang === 'fr')
    .map((post) => ({
      params: { slug: post.id.replace('fr/', '') },
      props: { post },
    }));
}

const { post } = Astro.props;
const slug = post.id.replace('fr/', '');
const alternates = postAlternates('fr', slug);
---

<Layout
  title={post.data.title}
  description={post.data.description}
  image={post.data.image}
  lang="fr"
  alternates={alternates}
  showPopup={false}
>
  <ArticleView post={post} backHref="/fr/admissions/" dateLocale="fr-FR" labels={{ back: 'Retour aux admissions', footerBack: 'Admissions', topics: 'Sujets :' }} />

  <VisitBand title="Visiter l'école">
    <p>Les étapes de l'inscription et la visite du campus sont présentées sur notre page Admissions.</p>
    <Fragment slot="actions">
      <a href="/fr/admissions/" class="btn-gold">Voir les admissions <ArrowRight size={18} aria-hidden="true" /></a>
    </Fragment>
  </VisitBand>
</Layout>
