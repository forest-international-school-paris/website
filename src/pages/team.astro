---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import PortraitList, { type Person } from '../components/PortraitList.astro';
import VisitBand from '../components/VisitBand.astro';
import { ArrowRight } from '@lucide/astro';

const leadership: Person[] = [
  { name: 'Ms. Sophie Lovejoy', role: 'Principal', image: '/images/team/sophie-lovejoy-2026.jpeg', position: '50% 10%' },
  { name: 'Mr. Kralka', role: 'STEM Teacher', image: '/images/team/mr-kralka.avif' },
  { name: 'Ms. Hannah', role: 'EY Lead & DSL', image: '/images/team/miss-hannah.avif' },
];

const staff: Person[] = [
  { name: 'Ms. Marie', role: 'Teacher', detail: 'French Lead', image: '/images/team/miss-marie.avif' },
  { name: 'Ms. Chloe', role: 'Teacher', image: '/images/team/miss-chloe.avif' },
  { name: 'Ms. Delphine', role: 'Teaching Assistant', image: '/images/team/miss-daulphine.avif' },
  { name: 'Mr. Elliot', role: 'LSS and EAL Teacher', image: '/images/team/mr-elliot.avif' },
  { name: 'Ms. Susanne Shamir', role: 'Administration', image: '/images/team/susanne-shamir.avif' },
  { name: 'Mr. Florent', role: 'Swimming Instructor', image: '/images/team/mr-florent.jpeg', position: 'top' },
  { name: 'Mr. John', role: 'Facilities Manager', image: '/images/team/mr-john.jpg', position: 'top' },
  { name: 'Ms. Felicity', role: 'Art Teacher', image: '/images/team/felicity-kelham.jpeg', position: 'top' },
  { name: 'Ms. Reena', role: 'Teaching Assistant', image: '/images/team/reena.jpg', position: '50% 25%' },
  { name: 'Ms. Hannah', role: 'EY Teacher', image: '/images/team/miss-hannah.avif' },
  { name: 'Mr. Kralka', role: 'STEM Teacher', image: '/images/team/mr-kralka.avif' },
  { name: 'Ms. Charlotte', role: 'English Teacher', image: '/images/team/charlotte.jpg', position: '50% 15%' },
];
---

<Layout title="Our team" description="Meet the teachers and staff at Forest International School Paris, an English-language school for children aged 2–15 in Mareil-Marly, west of Paris.">
  <PageHero title="The people your child will know" intro="The teachers, assistants and staff of Forest International School Paris, from Early Years to Middle School." />

  <section class="page-section" aria-labelledby="leadership-title">
    <div class="container-main leadership-layout">
      <h2 id="leadership-title">Leadership</h2>
      <PortraitList people={leadership} />
    </div>
  </section>

  <section class="page-section surface staff-section" aria-labelledby="staff-title">
    <div class="container-main">
      <h2 id="staff-title">Teachers and staff</h2>
      <PortraitList people={staff} size="compact" />
    </div>
  </section>

  <VisitBand title="Meet the team in person">
    <p>Book a visit to meet the team and see the campus.</p>
    <Fragment slot="actions">
      <a href="/contact/" class="btn-gold">Book a visit <ArrowRight size={18} aria-hidden="true" /></a>
      <a href="/admissions/" class="link-on-dark">Start your application <ArrowRight size={18} aria-hidden="true" /></a>
    </Fragment>
  </VisitBand>
</Layout>

<style>
  .leadership-layout { display: grid; grid-template-columns: .8fr 1.5fr; gap: 1rem 3rem; align-items: start; }
  .staff-section h2 { margin-bottom: 2.5rem; }
  @media (max-width: 900px) { .leadership-layout { grid-template-columns: 1fr; } }
</style>
