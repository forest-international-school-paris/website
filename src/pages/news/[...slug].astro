---
import Layout from '../../layouts/Layout.astro';
import ArticleView from '../../components/ArticleView.astro';
import VisitBand from '../../components/VisitBand.astro';
import { ArrowRight } from '@lucide/astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter(post => post.data.lang === 'en')
    .map((post) => ({
      params: { slug: post.id.replace('en/', '') },
      props: { post },
    }));
}

const { post } = Astro.props;
const slug = post.id.replace('en/', '');
const translations: Record<string, string> = {
  'english-school-paris-pre-elementary-primary': '/fr/news/ecole-anglaise-paris-maternelle-primaire/',
};
const alternates = translations[slug]
  ? [
      { hreflang: 'en', href: `/news/${slug}` },
      { hreflang: 'fr', href: translations[slug] },
      { hreflang: 'x-default', href: `/news/${slug}` },
    ]
  : [];
---

<Layout title={post.data.title} description={post.data.description} image={post.data.image} alternates={alternates}>
  <ArticleView post={post} backHref="/news/" dateLocale="en-GB" labels={{ back: 'Back to news', footerBack: 'Back to all news', topics: 'Topics:' }} />

  <VisitBand title="Come and see the school">
    <p>Book a visit to see the campus and meet the team.</p>
    <Fragment slot="actions">
      <a href="/contact/" class="btn-gold">Book a visit <ArrowRight size={18} aria-hidden="true" /></a>
      <a href="/admissions/" class="link-on-dark">How to apply <ArrowRight size={18} aria-hidden="true" /></a>
    </Fragment>
  </VisitBand>
</Layout>
