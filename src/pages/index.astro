<script is:inline>const tabs=[...document.querySelectorAll('#life-options [role="tab"]')];function choose(n,focus=false){tabs.forEach((t,i)=>{t.setAttribute('aria-selected',String(i===n));t.tabIndex=i===n?0:-1;document.getElementById(t.getAttribute('aria-controls')).hidden=i!==n});if(focus)tabs[n].focus()}tabs.forEach((t,n)=>{t.addEventListener('click',()=>choose(n));t.addEventListener('keydown',e=>{let k=n;if(['ArrowDown','ArrowRight'].includes(e.key))k=(n+1)%tabs.length;else if(['ArrowUp','ArrowLeft'].includes(e.key))k=(n+tabs.length-1)%tabs.length;else if(e.key==='Home')k=0;else if(e.key==='End')k=tabs.length-1;else return;e.preventDefault();choose(k,true)})});</script>

<script>
  const video = document.querySelector<HTMLVideoElement>('#school-video');
  const play = document.querySelector<HTMLButtonElement>('.film-play');
  if (video && play) {
    play.hidden = false;
    video.controls = false;
    play.addEventListener('click', async () => {
      play.hidden = true;
      video.controls = true;
      video.focus();
      try { await video.play(); } catch { /* Native controls remain available if playback is blocked. */ }
    });
    video.addEventListener('play', () => { play.hidden = true; video.controls = true; });
    video.addEventListener('ended', () => { play.hidden = false; video.controls = false; });
    video.addEventListener('error', () => { play.hidden = true; video.controls = true; });
  }
</script>
