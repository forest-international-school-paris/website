---
import Layout from '../layouts/Layout.astro';
import { ArrowRight, ArrowUpRight, Play, Star } from '@lucide/astro';

const programmes = [
  { name: 'Early Years', ages: 'Ages 2–5', href: '/early-years/', image: '/images/forest-walk.jpg', alt: 'Early years outdoor learning', description: 'Project-based play and collaborative exploration.' },
  { name: 'Primary School', ages: 'Ages 6–11', href: '/primary/', image: '/images/gallery-2.jpg', alt: 'Primary school forest activities', description: 'English National Curriculum combined with the International Primary Curriculum.' },
  { name: 'Middle School', ages: 'Ages 11–15', href: '/middle-school/', image: '/images/outdoor-learning.jpg', alt: 'Middle school outdoor learning', description: 'Independent thinking and critical thinking skills through project-based learning.' }
];
const team = [
  { name: 'Ms. Sophie Lovejoy', role: 'Principal', image: '/images/team/sophie-lovejoy-2026.jpeg', position: '50% 10%' },
  { name: 'Mr Kralka', role: 'Assistant Head', image: '/images/team/mr-kralka.avif', position: 'center' },
  { name: 'Miss Hannah', role: 'EY Lead & DSL', image: '/images/team/miss-hannah.avif', position: 'center' }
];
const reviews = [
  {
    "quote": "\"We moved to France for this school! As school principals in the U.S., we wanted a child-centered, project-based, multi-age learning environment with a strong indoor-outdoor balance. FISP exceeded our expectations and beautifully supported our daughter's transition between two countries.\"",
    "name": "Barbara & Garrett S.",
    "role": "Primary Student Parents"
  },
  {
    "quote": "\"We are a Brazilian family and our biggest concern was finding a welcoming and kind school for our children. Fortunately, we found FISP, where the entire team was extremely patient and welcomed our family. We are happy to be part of this school that has a high level of teaching and that does everything with a lot of love and dedication.\"",
    "name": "Camila & Diego H.",
    "role": "Nursery & Primary School Students Parents"
  },
  {
    "quote": "\"Our child thrives at Forest International School of Paris! The nature-based learning, small class sizes, and caring teachers create an inspiring environment. We've seen incredible growth in confidence, creativity, and curiosity. The location is also top!\"",
    "name": "Marie & Thomas L.",
    "role": "Middle School Student Parents"
  }
];
---

<Layout title="International School in West Paris" titleBrand="Forest International" description="English-language international school for ages 2–15 in Mareil-Marly, west of Paris. Discover our curriculum, forest learning and school life.">
  <section class="home-hero" aria-labelledby="home-title">
    <picture>
      <source type="image/avif" sizes="(max-width: 640px) 904px, (max-width: 1478px) 1478px, 100vw" srcset="/images/campus-hero-640.avif 640w, /images/campus-hero-960.avif 960w, /images/campus-hero-1440.avif 1440w, /images/campus-hero-1829.avif 1829w" />
      <img src="/images/campus-hero-1440.webp" alt="The school building and garden beside a hedge-lined path" class="hero-image" width="1829" height="713" fetchpriority="high" decoding="async" sizes="(max-width: 640px) 904px, (max-width: 1478px) 1478px, 100vw" srcset="/images/campus-hero-640.webp 640w, /images/campus-hero-960.webp 960w, /images/campus-hero-1440.webp 1440w, /images/campus-hero-1829.webp 1829w" />
    </picture>
    <div class="container-main hero-content">
      <p class="hero-location">Mareil-Marly · Near Saint-Germain-en-Laye · Since 2003</p>
      <h1 id="home-title">An international school in west Paris</h1>
      <p class="hero-intro">English-language education for children aged 2–15, combining the English National Curriculum with learning in nature.</p>
      <div class="hero-actions">
        <a href="/contact/" class="btn-gold">Book a visit <ArrowRight size={18} aria-hidden="true" /></a>
        <a href="#programmes" class="hero-link">Explore our programmes <ArrowRight size={18} aria-hidden="true" /></a>
      </div>
    </div>
  </section>

  <section id="welcome" class="home-section welcome-section" aria-labelledby="welcome-title">
    <div class="welcome-layout">
      <h2 id="welcome-title">Learning in the classroom and the forest</h2>
      <figure class="school-film">
        <div class="film-player">
        <video id="school-video" controls playsinline preload="none" poster="/images/school-film-20-5s.jpg" aria-label="A day at Forest International School Paris">
          <source src="https://video.wixstatic.com/video/2ed1b4_c1cd48d1d7cf45ec9653c9b9d653dca3/1080p/mp4/file.mp4" type="video/mp4" />
          Your browser does not support the video tag.
        </video>
        <button class="film-play" type="button" hidden aria-controls="school-video"><span class="play-disc"><Play size={28} fill="currentColor" aria-hidden="true" /></span><span>Watch a day at Forest</span></button>
        </div>
        <figcaption class="media-caption">A day at Forest International School Paris</figcaption>
      </figure>
      <div class="welcome-copy">
        <div>
          <p class="welcome-lead">Children learn through hands-on projects and daily activities in the forest.</p>
          <a href="/about/" class="text-link">About the school <ArrowRight size={18} aria-hidden="true" /></a>
        </div>
        <p>For over twenty years, we have been part of the Forest School movement in the west of Paris. Our project-based approach combines the English National Curriculum with learning in nature.</p>
      </div>
    </div>
  </section>

  <section id="life-options" aria-labelledby="learning-title"><div class="life-inner"><h2 id="learning-title">School life at Forest</h2><div class="life-explorer"><div role="tablist" aria-label="School life topics"><button role="tab" id="life-tab-0" aria-controls="life-panel-0" aria-selected="false" tabindex="-1">English National Curriculum</button><button role="tab" id="life-tab-1" aria-controls="life-panel-1" aria-selected="false" tabindex="-1">Small Class Sizes</button><button role="tab" id="life-tab-2" aria-controls="life-panel-2" aria-selected="true" tabindex="0">Nature-Based Learning</button><button role="tab" id="life-tab-3" aria-controls="life-panel-3" aria-selected="false" tabindex="-1">International Education</button><button role="tab" id="life-tab-4" aria-controls="life-panel-4" aria-selected="false" tabindex="-1">Modern Facilities</button><button role="tab" id="life-tab-5" aria-controls="life-panel-5" aria-selected="false" tabindex="-1">International Community</button></div><div class="life-panels"><div role="tabpanel" id="life-panel-0" aria-labelledby="life-tab-0" tabindex="0" hidden><figure><div class="life-photo"><img src="/images/school-life/classroom.jpg" alt="Children working together around a classroom table" loading="lazy" width="1138" height="640"></div></figure><div class="life-copy"><p>Teaching combines the English National Curriculum with the International Primary Curriculum in Primary and the International Middle Years Curriculum in Middle School. Project-based lessons connect subjects and give children opportunities to explore ideas in the classroom and outdoors.</p></div></div><div role="tabpanel" id="life-panel-1" aria-labelledby="life-tab-1" tabindex="0" hidden><figure><div class="life-photo"><img src="/images/school-life/individual-guidance.jpg" alt="A teacher guiding a child during a classroom activity" loading="lazy" width="1138" height="640"></div></figure><div class="life-copy"><p>With a maximum of 15 students per class, teachers can give each child individual attention and adapt learning to their needs. Mixed-age groups also give children opportunities to learn from one another, while progressing at their own pace.</p></div></div><div role="tabpanel" id="life-panel-2" aria-labelledby="life-tab-2" tabindex="0"><figure><div class="life-photo"><img src="/images/gallery-2.jpg" alt="Children exploring the forest" loading="lazy" width="1600" height="1067"></div></figure><div class="life-copy"><p>The forest is part of school life throughout the year. Through exploration, observation and creative activities outdoors, children connect what they learn in class with the natural world around them.</p></div></div><div role="tabpanel" id="life-panel-3" aria-labelledby="life-tab-3" tabindex="0" hidden><figure><div class="life-photo"><img src="/images/school-life/international-flags.jpg" alt="Flags from different countries in the school’s introduction film" loading="lazy" width="1138" height="640"></div></figure><div class="life-copy"><p>Children learn in English, with French taught to both native speakers and those learning it as a new language. This sits alongside an international curriculum and a multicultural school environment, bringing different languages and perspectives into their education.</p></div></div><div role="tabpanel" id="life-panel-4" aria-labelledby="life-tab-4" tabindex="0" hidden><figure><div class="life-photo"><img src="/images/school-life/swimming-pool.jpg" alt="The covered swimming pool at Forest" loading="lazy" width="1138" height="640"></div></figure><div class="life-copy"><p>Classrooms have interactive whiteboards and computers, alongside a library with books in English, French and Dutch. A covered heated swimming pool, gardens and access to the forest provide spaces for reading, practical learning and physical activity.</p></div></div><div role="tabpanel" id="life-panel-5" aria-labelledby="life-tab-5" tabindex="0" hidden><figure><div class="life-photo"><img src="/images/school-life/learning-together.jpg" alt="Children taking part in a shared classroom activity" loading="lazy" width="1138" height="640"></div></figure><div class="life-copy"><p>Local and expatriate families bring different languages, cultures and experiences to school life. Children learn alongside classmates from a range of backgrounds, making the school community part of their everyday experience of an international education.</p></div></div></div></div></div></section>

  <section class="home-section team-section" aria-labelledby="team-title">
    <div class="container-main team-layout">
      <div>
        <h2 id="team-title">Meet our teachers</h2>
        <p>Meet the team behind your child's education at Forest International School Paris.</p>
        <a href="/team/" class="text-link">Meet the full team <ArrowRight size={18} aria-hidden="true" /></a>
      </div>
      <div class="team-list">
        {team.map((person) => (
          <figure>
            <img src={person.image} alt={person.name} style={{ objectPosition: person.position }} width="200" height="240" loading="lazy" />
            <figcaption><strong>{person.name}</strong><span>{person.role}</span></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section id="programmes" class="home-section programme-section" aria-labelledby="programme-title">
    <div class="container-main">
      <div class="section-heading">
        <div>
          <h2 id="programme-title">From Early Years to Middle School</h2>
          <p>Explore the curriculum and daily life for your child's age group.</p>
        </div>
      </div>
      <div class="programme-list">
        {programmes.map((programme) => (
          <a href={programme.href} class="programme-link">
            <div class="programme-image"><img src={programme.image} alt={programme.alt} loading="lazy" width="640" height="480" /></div>
            <div class="programme-copy">
              <p class="programme-age">{programme.ages}</p>
              <h3>{programme.name} <ArrowUpRight size={22} aria-hidden="true" /></h3>
              <p>{programme.description}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="home-section campus-section" aria-labelledby="campus-title">
    <div class="container-main">
      <div class="section-heading">
        <h2 id="campus-title">Our campus in Mareil-Marly</h2>
        <a href="/contact/" class="text-link">Arrange a visit <ArrowRight size={18} aria-hidden="true" /></a>
      </div>
      <img src="/images/campus.jpg" alt="Campus overview showing the school buildings, garden, playground and swimming pool" class="campus-image" width="1920" height="1059" loading="lazy" />
    </div>
  </section>

  <section class="home-section parent-section" aria-labelledby="parent-title">
    <div class="container-main">
      <h2 id="parent-title">In parents' words</h2>
      <div class="parent-quotes">
        {reviews.map((review) => (
          <figure>
            <div class="review-content">
              <div class="review-stars" aria-hidden="true">{Array.from({ length: 5 }, () => <Star size={18} fill="currentColor" />)}</div>
              <blockquote><p>{review.quote}</p></blockquote>
            </div>
            <figcaption><strong>{review.name}</strong><span>{review.role}</span></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="home-section camp-section" aria-labelledby="camp-title">
    <div class="container-main camp-layout">
      <img src="/images/summer-camp.jpg" alt="Summer camp at Forest International School" width="640" height="480" loading="lazy" />
      <div>
        <h2 id="camp-title">Summer &amp; holiday camps</h2>
        <p>Outdoor adventures, creative activities and learning during the school holidays. Our camps are open to all children aged 2–12, including children who do not attend Forest School.</p>
        <ul class="camp-activities">
          <li>Forest exploration &amp; nature activities</li>
          <li>Swimming pool access</li>
          <li>Arts, crafts &amp; creative projects</li>
          <li>International environment</li>
        </ul>
        <a href="/holiday-camps/" class="btn-primary">Explore holiday camps <ArrowRight size={18} aria-hidden="true" /></a>
      </div>
    </div>
  </section>

  <section class="home-section visit-section" aria-labelledby="visit-title">
    <div class="container-main visit-layout">
      <div>
        <h2 id="visit-title">Come and meet us</h2>
        <p>Fill out our enquiry form and our admissions team will contact you within 24–48 hours to schedule a visit.</p>
        <p class="visit-note">No commitment required. Personal campus tours available.</p>
      </div>
      <div class="visit-actions">
        <a href="https://docs.google.com/forms/d/e/1FAIpQLSfMa-d1ZWAsQUoe6ximaoczCAw5CK7YS1CHOKs6NSV-M8AjCQ/viewform?usp=header" target="_blank" rel="noopener noreferrer" class="btn-gold">Make an enquiry <ArrowUpRight size={18} aria-hidden="true" /><span class="sr-only"> (opens in a new tab)</span></a>
        <a href="/admissions/" class="hero-link">How to apply <ArrowRight size={18} aria-hidden="true" /></a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .home-section { padding-block: var(--space-section); }
  .home-section h2 { color: var(--color-forest-dark); font-size: clamp(2rem, 3.1vw, 2.75rem); line-height: 1.18; margin-bottom: 1.25rem; }
  .home-section p { max-width: 65ch; line-height: 1.75; }
  .home-section p + p { margin-top: 1rem; }
  .home-hero { position: relative; isolation: isolate; min-height: 40rem; display: flex; align-items: center; background: var(--color-forest-dark); color: white; }
  .hero-image { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; object-position: center; }
  .home-hero::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgb(15 37 24 / 88%) 0%, rgb(15 37 24 / 78%) 30%, rgb(15 37 24 / 48%) 46%, transparent 67%, transparent 100%); }
  .hero-content { width: 100%; padding-block: clamp(3.5rem, 6vw, 6rem); }
  .hero-location { max-width: 60ch; font-size: .875rem; line-height: 1.6; margin-bottom: 1.5rem; color: #e5eecf; font-weight: 600; }
  .home-hero h1 { max-width: 17ch; font-size: clamp(2.5rem, 4.8vw, 4.5rem); line-height: 1.12; letter-spacing: -0.025em; }
  .hero-intro { max-width: 43ch; margin-top: 1.5rem; font-size: clamp(1rem, 1.25vw, 1.125rem); line-height: 1.75; color: #f1f5f2; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: .75rem 1.5rem; align-items: center; margin-top: 2rem; }
  .hero-link { display: inline-flex; gap: .75rem; align-items: center; min-height: 48px; color: white; font-weight: 600; text-decoration: underline; text-decoration-color: rgb(255 255 255 / 55%); text-underline-offset: .35em; transition: color var(--duration-fast) var(--ease-out); }
  .hero-link:hover { color: var(--color-gold); }
  @media (min-width: 641px) and (max-width: 1000px) {
    .home-hero::before { background: linear-gradient(90deg, rgb(15 37 24 / 94%) 0%, rgb(15 37 24 / 84%) 45%, rgb(15 37 24 / 25%) 80%, rgb(15 37 24 / 8%) 100%); }
  }
  .welcome-section { padding-block: clamp(3rem, 6vw, 5rem); scroll-margin-top: 104px; }
  .welcome-layout { width: min(100% - 3rem, 1120px); margin-inline: auto; }
  .welcome-section h2 { max-width: 27ch; text-align: center; margin: 0 auto 2.5rem; font-size: clamp(2rem, 3.6vw, 3.25rem); line-height: 1.16; letter-spacing: -.02em; }
  .school-film { max-width: 1120px; margin-inline: auto; }
  .school-film video { display: block; width: 100%; aspect-ratio: 16/9; background: var(--color-forest-dark); border-radius: var(--radius-media); }
  .media-caption { text-align: center; font-size: .875rem; line-height: 1.6; color: var(--color-text-muted); margin-top: .75rem; }
  .welcome-copy { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 4vw, 4rem); max-width: 960px; margin: 2rem auto 0; align-items: start; }
  .welcome-copy .welcome-lead { font-family: var(--font-heading, "Playfair Display", serif); font-size: clamp(1.5rem, 2.3vw, 2rem); line-height: 1.4; color: var(--color-forest-dark); }
  .welcome-copy p { margin: 0; line-height: 1.8; }
  .welcome-copy .text-link, .team-layout .text-link { margin-top: 1.5rem; }
  @media (max-width: 760px) {
    .welcome-layout { width: calc(100% - 2rem); }
    .welcome-section h2 { margin-bottom: 1.5rem; }
    .welcome-copy { grid-template-columns: 1fr; }
  }
  .camp-section { background: var(--color-surface); }
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 1.5rem 3rem; margin-bottom: 2.5rem; }
  .section-heading h2 { max-width: 21ch; margin-bottom: .75rem; }
  .section-heading > .text-link { flex-shrink: 0; }
  .programme-list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; }
  .programme-link { min-width: 0; display: block; border-radius: var(--radius-media); }
  .programme-image { overflow: hidden; border-radius: var(--radius-media); }
  .programme-image img { width: 100%; aspect-ratio: 8/5; object-fit: cover; transition: transform var(--duration-slow) var(--ease-out); }
  .programme-link:hover img { transform: scale(1.025); }
  .programme-copy { padding-block: 1.25rem; }
  .programme-copy .programme-age { font-size: .875rem; font-weight: 600; color: var(--color-text-muted); margin-bottom: .5rem; }
  .programme-copy h3 { display: flex; justify-content: space-between; gap: .5rem; align-items: center; font-size: 1.625rem; color: var(--color-forest-dark); }
  .programme-copy h3 svg { flex-shrink: 0; }
  .programme-copy > p:last-child { margin-top: .75rem; }
  .programme-link:hover h3 { text-decoration: underline; text-underline-offset: .2em; }
  .learning-layout { display: grid; grid-template-columns: .9fr 1fr; gap: clamp(2rem, 7vw, 6rem); align-items: start; }
  .learning-intro img { width: 100%; aspect-ratio: 4/3; object-fit: cover; border-radius: var(--radius-media); margin-top: 2rem; }
  .learning-details > div { padding-block: 1.25rem; border-bottom: 1px solid var(--color-line); }
  .learning-details > div:first-child { padding-top: 0; }
  .learning-details dt { font-weight: 600; color: var(--color-forest-dark); margin-bottom: .375rem; font-size: 1.0625rem; }
  .learning-details dd { line-height: 1.65; }
  .campus-section { padding-block: var(--space-section); }
  .campus-image { width: 100%; height: auto; border-radius: var(--radius-media); }
  .parent-section, .visit-section { background: var(--color-forest-dark); color: white; }
  .parent-section h2, .visit-section h2 { color: white; }
  .parent-quotes { display: grid; grid-template-columns: 1.25fr 1fr; gap: 3rem 5rem; margin-top: 3rem; }
  .parent-quotes figure:first-child { grid-row: span 2; justify-content: center; }
  .parent-quotes figure:first-child blockquote { font-family: "Playfair Display", serif; font-size: clamp(1.5rem, 2.3vw, 2rem); }
  .parent-quotes figure:first-child blockquote p { line-height: 1.5; }
  .parent-quotes figure { display: flex; flex-direction: column; justify-content: space-between; }
  .review-stars { display: flex; gap: .25rem; color: var(--color-gold); margin-bottom: 1rem; }
  .parent-quotes blockquote p { line-height: 1.8; }
  .parent-quotes figcaption { margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid rgb(255 255 255 / 25%); font-size: .875rem; }
  .parent-quotes strong { display: block; color: var(--color-gold); }
  .parent-quotes figcaption span { display: block; margin-top: .375rem; color: #d4dfd7; }
  .team-section { background: var(--color-surface); }
  .team-layout { display: grid; grid-template-columns: .8fr 1.5fr; align-items: center; gap: 3rem; }
  .team-list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; }
  .team-list img { width: 100%; aspect-ratio: 5/6; object-fit: cover; border-radius: var(--radius-media); }
  .team-list figcaption { margin-top: 1rem; font-size: .875rem; }
  .team-list strong, .team-list span { display: block; }
  .team-list strong { color: var(--color-forest-dark); }
  .team-list span { margin-top: .375rem; color: var(--color-text-muted); }
  .camp-layout { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: clamp(2rem, 6vw, 5rem); }
  .camp-layout > img { width: 100%; aspect-ratio: 4/3; object-fit: cover; border-radius: var(--radius-media); }
  .camp-activities { margin: 1.25rem 0 2rem; padding-left: 1.25rem; list-style: disc; line-height: 1.9; }
  .camp-activities li::marker { color: var(--color-forest-green); }
  .visit-layout { display: flex; align-items: center; justify-content: space-between; gap: 2rem 4rem; }
  .visit-layout > div:first-child { max-width: 38rem; }
  .visit-note { color: #d4dfd7; font-size: .9375rem; }
  .visit-actions { display: flex; flex-direction: column; align-items: start; gap: .75rem; flex-shrink: 0; }
  @media (max-width: 900px) {
    .learning-layout, .team-layout { grid-template-columns: 1fr; }
    .learning-intro { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 2rem; }
    .learning-intro img { margin-top: 0; }
    .programme-list { gap: 1.25rem; }
    .programme-copy h3 { font-size: 1.375rem; }
    .parent-quotes { grid-template-columns: 1fr; gap: 2rem; }
    .parent-quotes figure { max-width: 65ch; }
    .parent-quotes figure:first-child { grid-row: auto; }
    .parent-quotes blockquote, .parent-quotes figure:first-child blockquote { font-family: inherit; font-size: 1rem; }
    .parent-quotes figure:first-child blockquote p { line-height: 1.8; }
    .visit-layout { align-items: start; flex-direction: column; }
  }
  @media (max-width: 640px) {
    .home-hero { min-height: 0; }
    .hero-image { height: 22rem; object-position: 65% center; }
    .home-hero::before { background: linear-gradient(180deg, transparent 0, rgb(30 61 41 / 8%) 8rem, rgb(30 61 41 / 88%) 15rem, var(--color-forest-dark) 22rem); }
    .hero-content { padding-top: 15rem; padding-bottom: 3rem; }
    .home-hero h1 { max-width: 18ch; }
    .section-heading { align-items: start; flex-direction: column; }
    .programme-list, .camp-layout, .learning-intro { grid-template-columns: 1fr; }
    .programme-copy h3 { font-size: 1.75rem; }
    .programme-link { display: grid; grid-template-columns: 5.5rem 1fr; gap: 1rem; padding-block: 1rem; border-bottom: 1px solid var(--color-line); border-radius: 0; }
    .programme-image img { aspect-ratio: 1; }
    .programme-copy { padding: 0; }
    .programme-copy h3 { font-size: 1.25rem; }
    .programme-copy > p:last-child { font-size: .9375rem; }
    .team-list { gap: .75rem; }
    .hero-actions { align-items: start; flex-direction: column; }
    .hero-location { margin-bottom: 1rem; }
    .team-list figcaption { overflow-wrap: anywhere; }
  }
  .film-player { position: relative; }
  .film-play { position: absolute; inset: 0; display: flex; flex-direction: column; gap: 1rem; align-items: center; justify-content: center; color: white; background: rgb(15 37 24 / 25%); border-radius: var(--radius-media); font-weight: 600; cursor: pointer; text-shadow: 0 1px 3px #102518; }
  .film-play[hidden] { display: none; }
