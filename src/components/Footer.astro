---
import { Clock, Mail, MapPin, MessageCircle, Phone } from '@lucide/astro';
import {
  frenchLinks, instagramUrl, mailHref, mainLinks, mapsUrl, programmeLinks,
  school, schoolHours, schoolLinks, telHref, whatsappHref, type SiteLink,
} from '../lib/site';

const mainLink = (href: string) => mainLinks.find((link) => link.href === href) as SiteLink;
const linkGroups: { title: string; lang?: string; links: SiteLink[] }[] = [
  { title: 'Programmes', links: [...programmeLinks, mainLink('/holiday-camps/')] },
  { title: 'Joining Forest', links: [mainLink('/admissions/'), mainLink('/tuition/'), { href: '/contact/', label: 'Contact and visits' }] },
  { title: 'The school', links: [...schoolLinks, mainLink('/news/')] },
  { title: 'En français', lang: 'fr', links: frenchLinks },
];
const [street, ...locality] = school.address.split(', ');
const [emailUser, emailDomain] = school.email.split('@');
const partners = [
  { src: '/images/inst_national.avif', alt: 'National Curriculum', width: 348, height: 232 },
  { src: '/images/inst_pearson.avif', alt: 'Pearson', width: 362, height: 109 },
  { src: '/images/inst_eco.avif', alt: 'Eco-Schools', width: 180, height: 232 },
  { src: '/images/inst_savio.avif', alt: 'SAVIO Education', width: 362, height: 242 },
];
const isCurrent = (href: string) => Astro.url.pathname.replace(/\/$/, '') === href.replace(/\/$/, '');
---

<footer class="site-footer">
  <div class="container-main footer-inner">
    <div class="footer-top">
      <div class="footer-intro">
        <a href="/" class="footer-brand" aria-label={`${school.name} — home`}>
          <img src="/images/logo-header.png" alt="" width="56" height="56" loading="lazy" decoding="async" />
          <span><strong>Forest International</strong><span>School Paris</span></span>
        </a>
        <p>An English-language school in Mareil-Marly, west of Paris, with learning in the classroom and the forest.</p>
        <a href={instagramUrl} class="footer-social" target="_blank" rel="noopener noreferrer">Follow school life on Instagram<span class="sr-only"> (opens in a new tab)</span></a>
      </div>

      <address class="footer-contact">
        <ul>
          <li>
            <MapPin size={20} aria-hidden="true" />
            <a href={mapsUrl} target="_blank" rel="noopener noreferrer">{street}<br />{locality.join(', ')}<span class="sr-only"> (open map in a new tab)</span></a>
          </li>
          <li><Phone size={20} aria-hidden="true" /><a href={telHref}>{school.phone}</a></li>
          <li><Mail size={20} aria-hidden="true" /><a href={mailHref}>{emailUser}@<wbr />{emailDomain}</a></li>
          <li><MessageCircle size={20} aria-hidden="true" /><a href={whatsappHref} target="_blank" rel="noopener noreferrer">Message us on WhatsApp<span class="sr-only"> (opens in a new tab)</span></a></li>
        </ul>
        <div class="footer-hours">
          <Clock size={20} aria-hidden="true" />
          <dl>
            {schoolHours.map((row) => <div><dt>{row.label}</dt><dd>{row.value}</dd></div>)}
          </dl>
        </div>
      </address>
    </div>

    <nav class="footer-links" aria-label="Footer">
      {linkGroups.map((group) => (
        <div lang={group.lang}>
          <h2>{group.title}</h2>
          <ul>
            {group.links.map((link) => (
              <li>
                <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
                  {link.label}{link.detail && <small>{link.detail}</small>}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </nav>

    <div class="footer-base">
      <ul class="footer-partners">
        {partners.map((logo) => <li><img {...logo} loading="lazy" decoding="async" /></li>)}
      </ul>
      <div class="footer-legal">
        <p>&copy; {new Date().getFullYear()} {school.name}. All rights reserved.</p>
        <p><a href="/legal/">Legal notice</a><span aria-hidden="true"> · </span><a href="/privacy/">Privacy policy</a></p>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    /* Clears the fixed WhatsApp button (3.5rem plus its 1.5rem offset) at the end of the page. */
    --footer-clearance: 6rem;
    --footer-muted: color-mix(in oklab, white 84%, var(--color-forest-green));
    --footer-rule: color-mix(in oklab, white 22%, var(--color-forest-green));
    background: var(--color-forest-green);
    color: white;
  }
  .footer-inner { padding-block: clamp(3rem, 6vw, 4.5rem) var(--footer-clearance); }
  .site-footer :is(a, p, dd) { overflow-wrap: anywhere; }
  .site-footer a { transition: color var(--duration-fast) var(--ease-out); }
  .site-footer a:hover { color: white; }
  .site-footer a:focus-visible { outline-color: var(--color-gold); box-shadow: none; }
  .site-footer svg { flex-shrink: 0; color: var(--color-gold); }

  .footer-top {
    display: grid;
    gap: 2.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--footer-rule);
  }
  .footer-intro p { max-width: 40ch; margin-top: 1.25rem; color: var(--footer-muted); line-height: 1.7; }
  .footer-brand { display: inline-flex; align-items: center; gap: .875rem; min-height: 44px; }
  .footer-brand img { width: 3.5rem; height: 3.5rem; border-radius: 50%; background: white; object-fit: contain; }
  .footer-brand strong { display: block; font-family: 'Playfair Display', Georgia, serif; font-size: 1.375rem; font-weight: 500; line-height: 1.2; }
  .footer-brand strong + span { display: block; font-size: .875rem; color: var(--footer-muted); }
  .footer-social {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: .75rem;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, white 55%, transparent);
    text-underline-offset: .3em;
  }

  .footer-contact { display: grid; gap: 1.5rem; font-style: normal; }
  .footer-contact ul { display: grid; gap: .25rem; }
  .footer-contact li, .footer-hours { display: flex; align-items: flex-start; gap: .75rem; }
  .footer-contact li svg { margin-top: .75rem; }
  .footer-contact li a { display: inline-flex; align-items: center; min-width: 0; min-height: 44px; padding-block: .5rem; color: var(--footer-muted); line-height: 1.5; }
  .footer-hours { color: var(--footer-muted); font-size: .9375rem; }
  .footer-hours svg { margin-top: .125rem; }
  .footer-hours dl { display: grid; gap: .25rem; }
  .footer-hours dl > div { display: flex; flex-wrap: wrap; gap: 0 .5rem; }
  .footer-hours dt { font-weight: 600; color: white; }

  .footer-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8.5rem, 1fr));
    gap: 2rem 1rem;
    padding-block: 2.5rem;
    border-bottom: 1px solid var(--footer-rule);
  }
  .footer-links h2 { margin-bottom: .5rem; font-family: inherit; font-size: 1rem; font-weight: 600; }
  .footer-links a { display: inline-flex; flex-wrap: wrap; align-items: baseline; gap: 0 .5rem; min-height: 44px; padding-block: .625rem; color: var(--footer-muted); line-height: 1.4; }
  .footer-links small { font-size: .8125rem; color: var(--footer-muted); }
  .footer-links a[aria-current='page'] { color: white; text-decoration: underline; text-underline-offset: .3em; }

  .footer-base { display: grid; gap: 2rem; padding-top: 2.5rem; }
  .footer-partners { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; }
  .footer-partners img { width: auto; height: 3.5rem; padding: .5rem; border-radius: var(--radius-control); background: white; object-fit: contain; }
  .footer-legal { display: grid; gap: .25rem; color: var(--footer-muted); font-size: .875rem; }
  .footer-legal a { display: inline-flex; align-items: center; min-height: 44px; text-decoration: underline; text-underline-offset: .25em; }

  @media (min-width: 768px) {
    .footer-top { grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr); gap: 3rem; }
  }
  @media (min-width: 1024px) {
    .footer-top { grid-template-columns: minmax(0, 1fr) minmax(0, 1.75fr); }
    .footer-contact { grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 2rem; }
    .footer-base { grid-template-columns: auto minmax(0, 1fr); align-items: center; }
    .footer-legal { justify-items: end; text-align: right; }
  }
</style>
