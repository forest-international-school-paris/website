---
import { legalEntity } from '../lib/site';

interface Props {
  title: string;
  frenchTitle: string;
}

const { title, frenchTitle } = Astro.props;
const updated = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })
  .format(new Date(legalEntity.updated));
---

<article class="legal-page">
  <header>
    <h1>{title}</h1>
    <p><span lang="fr">{frenchTitle}</span> · Last updated {updated}</p>
  </header>
  <div class="legal-body">
    <slot />
  </div>
</article>

<style>
  .legal-page { max-width: 46rem; margin-inline: auto; padding: var(--space-section) clamp(1rem, 4vw, 2rem); }
  header { padding-bottom: 2rem; margin-bottom: 2rem; border-bottom: 1px solid var(--color-line); }
  h1 { color: var(--color-forest-dark); font-size: clamp(2.25rem, 4vw, 3rem); line-height: 1.15; letter-spacing: -0.02em; }
  header p { margin-top: .75rem; color: var(--color-text-muted); font-size: .9375rem; }
  .legal-body :global(h2) { margin-top: 2.5rem; margin-bottom: .75rem; color: var(--color-forest-dark); font-size: 1.5rem; line-height: 1.3; }
  .legal-body :global(h3) { margin-top: 1.5rem; margin-bottom: .5rem; color: var(--color-forest-dark); font-family: inherit; font-size: 1.0625rem; font-weight: 600; }
  .legal-body :global(:is(p, li)) { max-width: 68ch; line-height: 1.75; }
  .legal-body :global(p + p) { margin-top: 1rem; }
  .legal-body :global(ul) { display: grid; gap: .5rem; margin-top: .75rem; padding-left: 1.25rem; list-style: disc; }
  .legal-body :global(a) { color: var(--color-forest-green); text-decoration: underline; text-underline-offset: .2em; overflow-wrap: anywhere; }
  .legal-body :global(dl) { display: grid; gap: 0; margin-top: 1.25rem; border-top: 1px solid var(--color-line); }
  .legal-body :global(dl > div) { display: grid; gap: .25rem 1.5rem; padding-block: .75rem; border-bottom: 1px solid var(--color-line); }
  .legal-body :global(dt) { font-weight: 600; color: var(--color-forest-dark); }
  @media (min-width: 640px) {
    .legal-body :global(dl > div) { grid-template-columns: 12rem minmax(0, 1fr); }
  }
</style>
