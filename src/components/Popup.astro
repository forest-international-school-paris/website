---
interface Props {
  enabled?: boolean;
  title?: string;
  subtitle?: string;
  date?: string;
  time?: string;
  message?: string;
  buttonText?: string;
  buttonLink?: string;
  secondaryButtonText?: string;
  secondaryButtonLink?: string;
  image?: string;
  badge?: string;
  programs?: { name: string; audience?: string; description: string; icon?: string }[];
  /** ISO start of a one-off event; turns the reopen badge into a calendar page with a countdown. */
  startsAt?: string;
  timeZone?: string;
}

const {
  enabled = true,
  title = "Wednesday MasterClasses",
  subtitle = "",
  date = "Every Wednesday",
  time = "8:00 AM - 6:00 PM",
  message = "",
  buttonText = "Register Now",
  buttonLink = "/contact/",
  secondaryButtonText = "",
  secondaryButtonLink = "",
  image = "",
  badge = "",
  programs = [],
  startsAt,
  timeZone = 'Europe/Paris'
} = Astro.props;

const closeText = 'Close';
const badgeText = badge || 'MasterClasses';
const eventPart = (options: Intl.DateTimeFormatOptions) =>
  startsAt && new Intl.DateTimeFormat('en-GB', { ...options, timeZone }).format(new Date(startsAt));
const calendarMonth = eventPart({ month: 'short' });
const calendarDay = eventPart({ day: 'numeric' });
const eventWeekday = eventPart({ weekday: 'long' });
---

{enabled && (
  <>
    <dialog data-event-name={title} data-event-date={date} id="announcement-popup" aria-labelledby="popup-title" aria-describedby="popup-message">
      <button id="popup-close" type="button" aria-label={closeText} autofocus>
        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
      {image && <img src={image} alt="Forest International School campus overview" class="popup-image" width="640" height="240" />}
      <div class="popup-body">
        <h2 id="popup-title">{title}</h2>
        {subtitle && <p class="popup-subtitle">{subtitle}</p>}
        <div class="popup-schedule"><strong>{date}</strong><span>{time}</span></div>
        <p id="popup-message">{message}</p>
        {programs.length > 0 && (
          <ul class="popup-programmes">
            {programs.map((programme) => (
              <li>
                <h3>{programme.name}</h3>
                {programme.audience && <p class="programme-audience">{programme.audience}</p>}
                <p>{programme.description}</p>
              </li>
            ))}
          </ul>
        )}
        <div class="popup-actions">
          <a data-announcement-cta href={buttonLink} target="_blank" rel="noopener noreferrer" class="btn-primary">{buttonText}<span class="sr-only"> (opens in a new tab)</span></a>
          {secondaryButtonText && secondaryButtonLink && <a href={secondaryButtonLink} class="text-link">{secondaryButtonText}</a>}
        </div>
      </div>
    </dialog>
    <button id="mini-badge-btn" type="button" class="announcement-badge" aria-haspopup="dialog" aria-controls="announcement-popup" hidden>
      {startsAt && (
        <span class="badge-calendar" aria-hidden="true"><span>{calendarMonth}</span><span>{calendarDay}</span></span>
      )}
      <span class="badge-text">
        <strong>{badgeText}</strong>
        {startsAt
          ? <span><span class="sr-only">{date}, </span>{eventWeekday}<span class="badge-countdown" data-starts-at={startsAt}></span></span>
          : <span>{date}</span>}
      </span>
    </button>
  </>
)}

<script>
  const popup = document.querySelector<HTMLDialogElement>('#announcement-popup');
  const closeBtn = document.getElementById('popup-close');
  const badgeBtn = document.getElementById('mini-badge-btn');

  if (popup && badgeBtn) {
    let seen = false;
    let previousOverflow = '';
    try { seen = sessionStorage.getItem('popup-shown') === 'true'; } catch { /* Storage may be unavailable in private browsing. */ }

    function showPopup() {
      if (!popup || popup.open) return;
      previousOverflow = document.body.style.overflow;
      popup.showModal();
      document.body.style.overflow = 'hidden';
      try { sessionStorage.setItem('popup-shown', 'true'); } catch { /* The dialog still works without storage. */ }
    }

    // "in 65 days" / "tomorrow" / "today", counted in whole calendar days.
    const countdown = badgeBtn.querySelector<HTMLElement>('.badge-countdown');
    if (countdown?.dataset.startsAt) {
      const startOfDay = (value: Date) => new Date(value.getFullYear(), value.getMonth(), value.getDate()).getTime();
      const dayMs = 24 * 60 * 60 * 1000;
      const days = Math.round((startOfDay(new Date(countdown.dataset.startsAt)) - startOfDay(new Date())) / dayMs);
      if (days >= 0) countdown.textContent = ` · ${new Intl.RelativeTimeFormat('en-GB', { numeric: 'auto' }).format(days, 'day')}`;
    }

    // Where the badge would cover page content, it rests as just the calendar page.
    // It shows its full text for a few seconds whenever it appears, and on hover or focus.
    const peekMs = 4000;
    let peekTimer = 0;
    function revealBadge() {
      if (!badgeBtn) return;
      badgeBtn.hidden = false;
      badgeBtn.classList.add('is-peeking');
      window.clearTimeout(peekTimer);
      peekTimer = window.setTimeout(() => badgeBtn.classList.remove('is-peeking'), peekMs);
    }

    if (seen) revealBadge();
    else window.setTimeout(showPopup, 15000);

    badgeBtn.addEventListener('click', showPopup);
    closeBtn?.addEventListener('click', () => popup.close());
    popup.addEventListener('close', () => {
      document.body.style.overflow = previousOverflow;
      revealBadge();
    });
    popup.addEventListener('click', (event) => {
      if (event.target !== popup) return;
      const rect = popup.getBoundingClientRect();
      if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) popup.close();
    });
  }
</script>

<style>
  dialog { position: fixed; inset: 0; margin: auto; padding: 0; width: min(32rem, calc(100% - 2rem)); max-height: calc(100dvh - 2rem); overflow-y: auto; border: 0; border-radius: var(--radius-media); color: var(--color-text); background: white; z-index: var(--z-modal); }
  dialog::backdrop { background: rgb(15 37 24 / 70%); }
  #popup-close { position: absolute; right: .75rem; top: .75rem; display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 50%; background: white; color: var(--color-forest-dark); cursor: pointer; }
  #popup-close:hover { background: var(--color-surface); }
  .popup-image { width: 100%; height: 11rem; object-fit: cover; }
  .popup-body { padding: clamp(1.25rem, 4vw, 2rem); }
  .popup-body h2 { font-size: 2rem; line-height: 1.2; color: var(--color-forest-dark); }
  .popup-subtitle { margin-top: .75rem; color: var(--color-text-muted); }
  .popup-schedule { display: flex; flex-wrap: wrap; gap: .375rem 1.25rem; padding-block: 1.25rem; margin-block: 1.25rem; border-block: 1px solid var(--color-line); color: var(--color-forest-dark); }
  #popup-message { line-height: 1.65; }
  .popup-actions { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem 1.5rem; margin-top: 1.5rem; }
  .popup-programmes { margin-top: 1.25rem; }
  .popup-programmes li { border-top: 1px solid var(--color-line); padding-block: 1rem; }
  .popup-programmes h3 { font-weight: 700; }
  .programme-audience { color: var(--color-text-muted); font-size: .875rem; }
  .announcement-badge { position: fixed; bottom: 1.5rem; left: 1.5rem; z-index: var(--z-contact); display: flex; align-items: center; gap: .875rem; padding: .625rem 1.125rem .625rem .625rem; min-height: 48px; border: 1px solid var(--color-line); border-radius: var(--radius-media); background: white; color: var(--color-forest-dark); text-align: left; cursor: pointer; transition: background-color var(--duration-fast) var(--ease-out); animation: badge-arrive var(--duration-slow) var(--ease-out) both; }
  .announcement-badge:hover { background: var(--color-surface); }
  .announcement-badge[hidden] { display: none; }
  .badge-text { display: flex; flex-direction: column; gap: .125rem; }
  .badge-text > span { font-size: .875rem; color: var(--color-text-muted); }
  .badge-countdown { color: var(--color-forest-green); font-weight: 600; }

  /* A tear-off calendar page: month on the green binding strip, day below. */
  .badge-calendar { display: grid; grid-template-rows: auto 1fr; width: 3rem; overflow: hidden; border: 1px solid var(--color-line); border-radius: var(--radius-control); background: white; text-align: center; transform-origin: 50% 0; transition: transform var(--duration-fast) var(--ease-out); }
  .badge-calendar span:first-child { padding-block: .125rem; background: var(--color-forest-green); color: white; font-size: .6875rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
  .badge-calendar span:last-child { padding-block: .125rem .25rem; font-family: 'Playfair Display', Georgia, serif; font-size: 1.5rem; line-height: 1.15; color: var(--color-forest-dark); }
  .announcement-badge:hover .badge-calendar, .announcement-badge:focus-visible .badge-calendar { transform: rotate(-4deg) translateY(-1px); }

  /* Below 1600px the full badge would overlap the 72rem content column, so it rests compact. */
  @media (max-width: 1599px) {
    .announcement-badge:has(.badge-calendar) { gap: 0; padding: .5rem; transition: background-color var(--duration-fast) var(--ease-out), padding var(--duration-slow) var(--ease-out); }
    .announcement-badge:has(.badge-calendar) .badge-text { max-width: 0; overflow: hidden; white-space: nowrap; opacity: 0; transition: max-width var(--duration-slow) var(--ease-out), opacity var(--duration-fast) var(--ease-out), margin var(--duration-slow) var(--ease-out); }
    .announcement-badge:has(.badge-calendar):is(:hover, :focus-visible, .is-peeking) { padding-right: 1.125rem; }
    .announcement-badge:has(.badge-calendar):is(:hover, :focus-visible, .is-peeking) .badge-text { max-width: 15rem; margin-left: .875rem; opacity: 1; }
  }

  @keyframes badge-arrive { from { opacity: 0; transform: translateY(.75rem); } }
  @media (prefers-reduced-motion: reduce) {
    .announcement-badge { animation: none; }
    .badge-calendar, .announcement-badge, .announcement-badge .badge-text { transition: none; }
    .announcement-badge:hover .badge-calendar, .announcement-badge:focus-visible .badge-calendar { transform: none; }
  }
  @media (max-width: 640px) { .announcement-badge { bottom: 1rem; left: 1rem; } }
</style>
