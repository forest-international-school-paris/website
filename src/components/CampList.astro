---
// Camp schedule for /holiday-camps/ and /fr/stages-vacances/. Facts shared by every camp are listed once;
// each camp shows only what differs (dates, hours, rate, extras), so the list stays short on phones.
import { ArrowUpRight } from '@lucide/astro';

export interface CampFact {
  label: string;
  value: string;
}

export interface Camp {
  key: string;
  season: string;
  title: string;
  registerUrl: string;
  description: string;
  hours: string;
  rate: string;
  dates?: string;
  /** Several weeks in one month: the month is written once, each week as a date range. */
  sessions?: { month: string; weeks: string[] };
  extra?: CampFact;
  photo?: { src: string; alt: string; width: number; height: number };
}

interface Props {
  camps: Camp[];
  sharedFacts: CampFact[];
  labels: { shared: string; sessions: string; register: string; registerHint: (title: string) => string };
}

const { camps, sharedFacts, labels } = Astro.props;
---

<div class="camp-schedule">
  <aside class="glance camp-shared" aria-labelledby="camp-shared-title">
    <h3 id="camp-shared-title">{labels.shared}</h3>
    <dl class="fact-list">
      {sharedFacts.map((fact) => <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>)}
    </dl>
  </aside>

  <ol class="camp-list">
    {camps.map((camp) => (
      <li>
        <article class="camp" aria-labelledby={`camp-${camp.key}`}>
          <div class="camp-when">
            <p class="camp-season">{camp.season}</p>
            {camp.dates && <p class="camp-dates">{camp.dates}</p>}
            {camp.sessions && (
              <>
                <p class="camp-dates">{camp.sessions.month}</p>
                <p class="camp-sessions-label">{labels.sessions}</p>
                <ul class="camp-sessions">
                  {camp.sessions.weeks.map((week) => <li>{week}</li>)}
                </ul>
              </>
            )}
          </div>

          <div class="camp-body">
            <h3 id={`camp-${camp.key}`} class="camp-title">{camp.title}</h3>
            <p class="camp-terms"><span>{camp.hours}</span><span class="camp-rate">{camp.rate}</span></p>
            <p class="camp-description">{camp.description}</p>
            {camp.extra && <p class="camp-extra"><span>{camp.extra.label}</span> {camp.extra.value}</p>}
            <a href={camp.registerUrl} target="_blank" rel="noopener noreferrer" class="btn-primary camp-register">
              {labels.register}<span class="sr-only">{labels.registerHint(camp.title)}</span>
              <ArrowUpRight size={18} aria-hidden="true" />
            </a>
            {camp.photo && <img src={camp.photo.src} alt={camp.photo.alt} width={camp.photo.width} height={camp.photo.height} loading="lazy" class="media-rounded camp-photo" />}
          </div>
        </article>
      </li>
    ))}
  </ol>
</div>

<style>
  .camp-schedule { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 20rem); gap: 0 clamp(2rem, 5vw, 4.5rem); align-items: start; }
  .camp-shared { grid-column: 2; grid-row: 1; position: sticky; top: 7.5rem; }
  .camp-shared .fact-list > div { grid-template-columns: 6rem minmax(0, 1fr); }
  .camp-list { grid-column: 1; grid-row: 1; }

  .camp { display: grid; grid-template-columns: minmax(0, 13rem) minmax(0, 1fr); gap: .75rem clamp(1.5rem, 4vw, 3rem); padding-block: clamp(1.75rem, 3.5vw, 2.5rem); border-top: 1px solid var(--color-line); }
  .camp-list > li:first-child .camp { border-top: 0; padding-top: 0; }
  .camp-body { min-width: 0; }

  .camp-season { font-size: .875rem; font-weight: 600; color: var(--color-gold-ink); margin-bottom: .25rem; }
  .camp-dates { font-family: 'Playfair Display', Georgia, serif; font-size: clamp(1.5rem, 2.4vw, 1.875rem); line-height: 1.2; color: var(--color-forest-dark); }
  .camp-sessions-label { margin-top: .5rem; font-size: .875rem; color: var(--color-text-muted); }
  .camp-sessions { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: .5rem; }
  .camp-sessions li { padding: .375rem .75rem; border: 1px solid var(--color-line); border-radius: var(--radius-control); background: white; font-weight: 600; font-size: .9375rem; line-height: 1.4; color: var(--color-forest-dark); white-space: nowrap; }

  .camp-title { font-family: inherit; font-size: 1.125rem; font-weight: 600; line-height: 1.4; }
  .camp-terms { display: flex; flex-wrap: wrap; gap: .25rem .5rem; margin-top: .375rem; color: var(--color-text); }
  /* The separator ends the first item, so a wrapped line never starts with a stray dot. */
  .camp-terms span:not(:last-child)::after { content: '·'; margin-left: .5rem; color: var(--color-text-muted); }
  .camp-rate { font-weight: 600; color: var(--color-forest-dark); }
  .camp-description { max-width: 60ch; margin-top: .75rem; line-height: 1.7; color: var(--color-text-muted); }
  .camp-extra { margin-top: .75rem; font-size: .9375rem; line-height: 1.6; }
  .camp-extra span { display: block; font-weight: 600; color: var(--color-forest-dark); }
  .camp-register { margin-top: 1.25rem; min-height: 44px; padding-block: .5rem; font-size: .9375rem; }
  .camp-photo { display: block; max-width: 26rem; margin-top: 1.75rem; }

  @media (max-width: 900px) {
    .camp-schedule { grid-template-columns: 1fr; }
    .camp-shared { grid-column: 1; grid-row: 1; position: static; margin-bottom: 2rem; }
    .camp-list { grid-column: 1; grid-row: 2; }
  }
  @media (max-width: 640px) {
    .camp { grid-template-columns: 1fr; gap: .5rem; padding-block: 1.75rem; }
    .camp-dates { font-size: 1.625rem; }
    .camp-photo { max-width: 100%; }
  }
</style>
