---
import registry from "../../seo/_registry.json";
const productionHosts = registry.posthog.production_hosts;
// PostHog analytics + critical event tracking.
// The PostHog project API key is a *public* client-side key by design — it ships
// to every visitor's browser in the page source (just like PostHog's own install
// snippet). It is safe to commit. We hardcode it as the default so production
// works without any build-env configuration, and still allow an env-var override
// (e.g. to point a staging build at a different project):
//   PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx   (optional override)
//   PUBLIC_POSTHOG_HOST=https://us.i.posthog.com            (optional override)
const posthogKey = import.meta.env.PUBLIC_POSTHOG_KEY || 'phc_xqBPSrfiPEQXzi3WH9w6RTnh8san2uTrVzjRxAcS6cPq';
const posthogHost = import.meta.env.PUBLIC_POSTHOG_HOST || 'https://us.i.posthog.com';
---

{posthogKey && (
  <script is:inline define:vars={{ posthogKey, posthogHost, productionHosts }}>
    (function () {
    // Keep local previews and staging visits out of production analytics.
    if (!productionHosts.includes(window.location.hostname)) return;
    // PostHog loader snippet
    !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init capture register register_once register_for_session unregister unregister_for_session getFeatureFlag getFeatureFlagPayload isFeatureEnabled reloadFeatureFlags updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures on onFeatureFlags onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey identify setPersonProperties group resetGroups setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags reset get_distinct_id getGroups get_session_id get_session_replay_url alias set_config startSessionRecording stopSessionRecording sessionRecordingStarted captureException loadToolbar get_property getSessionProperty createPersonProfile opt_in_capturing opt_out_capturing has_opted_in_capturing has_opted_out_capturing clear_opt_in_out_capturing debug".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);

    posthog.init(posthogKey, {
      api_host: posthogHost,
      person_profiles: 'identified_only',
      capture_pageview: true,
      capture_pageleave: true,
      autocapture: true,
      // No cookies or browser storage: PostHog counts visitors with a server-side
      // privacy-preserving hash ("Cookieless server hash mode" must be on in the project).
      cookieless_mode: 'always',
      disable_session_recording: true,
    });

    // --- Critical events -------------------------------------------------
    // One delegated listener maps outbound CTAs to named conversion events,
    // so we don't have to annotate every link across the site.
    document.addEventListener('click', function (e) {
      var link = e.target && e.target.closest ? e.target.closest('a') : null;
      if (!link) return;
      var href = link.getAttribute('href') || '';
      if (!href) return;

      var props = {
        href: href,
        text: (link.textContent || '').trim().slice(0, 120),
        path: window.location.pathname,
      };

      // Calendar selection is intent only, never a saved event or attendance.
      if (link.dataset.calendarProvider) {
        posthog.capture('calendar_option_click', {
          provider: link.dataset.calendarProvider,
          event_id: link.dataset.calendarEvent,
          path: window.location.pathname,
        });
        return;
      }

      var announcement = link.closest('#announcement-popup');
      if (announcement && link.hasAttribute('data-announcement-cta')) {
        props.event_name = announcement.dataset.eventName;
        props.event_date = announcement.dataset.eventDate;
        posthog.capture('event_register_click', props);
        return;
      }

      // Google Forms — these events measure clicks, not completed submissions.
      if (href.indexOf('docs.google.com/forms') !== -1) {
        var path = window.location.pathname;
        if (path === '/contact' || path.indexOf('/contact/') !== -1) {
          posthog.capture('contact_form_click', props);
        } else if (link.closest('#masterclasses')) {
          posthog.capture('masterclass_register_click', props);
        } else {
          posthog.capture('apply_click', props);
        }
        return;
      }

      if (href.indexOf('wa.me') !== -1 || href.indexOf('whatsapp') !== -1) {
        posthog.capture('whatsapp_click', props);
      } else if (href.indexOf('mailto:') === 0) {
        posthog.capture('email_click', props);
      } else if (href.indexOf('tel:') === 0) {
        posthog.capture('phone_click', props);
      }
    });

    // Fire popup_shown when the announcement popup becomes visible.
    (function () {
      function watchPopup() {
        var popup = document.getElementById('announcement-popup');
        if (!popup) return;
        var seen = false;
        var report = function () {
          if (seen) return;
          if (popup.open) {
            seen = true;
            posthog.capture('popup_shown', {
              path: window.location.pathname,
              event_name: popup.dataset.eventName,
              event_date: popup.dataset.eventDate,
            });
          }
        };
        new MutationObserver(report).observe(popup, {
          attributes: true,
          attributeFilter: ['open'],
        });
        report();
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', watchPopup);
      } else {
        watchPopup();
      }
    })();
    })();
  </script>
)}
