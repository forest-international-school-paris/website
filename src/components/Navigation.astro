---
import { ArrowRight, ChevronDown, Mail, Menu, Phone, Play, Sun, X } from '@lucide/astro';
import { mailHref, mainLinks, programmeLinks, school, schoolLinks, telHref } from '../lib/site';

const isCurrent = (href: string) => Astro.url.pathname.replace(/\/$/, '') === href.replace(/\/$/, '');
---

<div class="contact-strip">
  <div class="nav-container contact-strip-inner">
    <div class="contact-strip-links">
      <a href={telHref}><Phone size={16} aria-hidden="true" />{school.phone}</a>
      <a href={mailHref}><Mail size={16} aria-hidden="true" />{school.email}</a>
    </div>
    <span>Mareil-Marly, Paris West</span>
  </div>
</div>

<nav id="main-nav" aria-label="Main navigation">
  <div class="nav-container nav-row">
    <a href="/" class="school-brand" aria-label="Forest International School Paris — home">
      <img src="/images/logo-header.png" alt="" width="60" height="60" />
      <span><strong>Forest International</strong><span>School Paris</span></span>
    </a>
    <div class="desktop-navigation">
      <details class="school-disclosure" id="school-disclosure">
        <summary><span class="nav-label">School</span> <ChevronDown size={16} aria-hidden="true" /></summary>
        <div class="school-dropdown">
          <div>
            <p>About Forest</p>
            {schoolLinks.map((link) => <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}><span>{link.label} <ArrowRight size={14} aria-hidden="true" /></span></a>)}
          </div>
          <div>
            <p>Programmes</p>
            <div class="growth-line">
              {programmeLinks.map((link) => <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}><span>{link.label} <ArrowRight size={14} aria-hidden="true" /></span><small>{link.detail}</small></a>)}
            </div>
          </div>
          <a href="/#welcome" class="dropdown-film">
            <span class="dropdown-film-image">
              <img src="/images/school-film-20-5s.jpg" alt="" width="1920" height="1080" loading="lazy" decoding="async" />
              <span class="dropdown-film-play"><Play size={16} fill="currentColor" aria-hidden="true" /></span>
            </span>
            <span>Watch a day at Forest</span>
          </a>
        </div>
      </details>
      {mainLinks.map((link) => <a href={link.href} class:list={['nav-link', { 'nav-camps': link.href === '/holiday-camps/' }]} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.href === '/holiday-camps/' && <Sun size={17} aria-hidden="true" />}<span class="nav-label">{link.label}</span></a>)}
    </div>
    <div class="nav-actions">
      <a href={telHref} class="nav-phone" aria-label={`Call the school: ${school.phone}`}>
        <Phone size={18} aria-hidden="true" /><span class="phone-number">{school.phone}</span><span class="phone-label">Call</span>
      </a>
      <a href="/contact/" class="btn-primary nav-visit">Book a visit</a>
    <button id="mobile-menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open navigation menu">
      <Menu id="menu-open-icon" size={22} aria-hidden="true" />
      <X id="menu-close-icon" size={22} aria-hidden="true" hidden />
      <span>Menu</span>
    </button>
    </div>
  </div>
  <div id="mobile-menu" hidden>
    <div class="nav-container mobile-links">
      <div class="mobile-school-links">
        {schoolLinks.map((link) => <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>)}
        <div class="growth-line">
          {programmeLinks.map((link) => <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}><span>{link.label}</span><small>{link.detail}</small></a>)}
        </div>
      </div>
      {mainLinks.map((link) => <a href={link.href} class:list={{ 'nav-camps': link.href === '/holiday-camps/' }} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.href === '/holiday-camps/' && <Sun size={18} aria-hidden="true" />}{link.label}</a>)}
      <a href="/contact/" class="btn-primary">Book a visit <ArrowRight size={18} aria-hidden="true" /></a>
      <a href={telHref} class="mobile-phone">Call {school.phone}</a>
    </div>
  </div>
</nav>

<script>
  const menuBtn = document.querySelector<HTMLButtonElement>('#mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const openIcon = document.getElementById('menu-open-icon');
  const closeIcon = document.getElementById('menu-close-icon');
  const schoolDisclosure = document.querySelector<HTMLDetailsElement>('#school-disclosure');

  function setMobileMenu(open: boolean) {
    if (!menuBtn || !mobileMenu) return;
    mobileMenu.hidden = !open;
    menuBtn.setAttribute('aria-expanded', String(open));
    menuBtn.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
    openIcon?.toggleAttribute('hidden', open);
    closeIcon?.toggleAttribute('hidden', !open);
  }

  menuBtn?.addEventListener('click', () => setMobileMenu(menuBtn.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    if (schoolDisclosure?.open) {
      schoolDisclosure.open = false;
      schoolDisclosure.querySelector('summary')?.focus();
    }
    if (menuBtn?.getAttribute('aria-expanded') === 'true') {
      setMobileMenu(false);
      menuBtn.focus();
    }
  });
  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Node)) return;
    if (schoolDisclosure && !schoolDisclosure.contains(event.target)) schoolDisclosure.open = false;
    if (mobileMenu && !mobileMenu.contains(event.target) && !menuBtn?.contains(event.target)) setMobileMenu(false);
  });
  schoolDisclosure?.addEventListener('focusout', (event) => {
    if (!(event.relatedTarget instanceof Node) || !schoolDisclosure.contains(event.relatedTarget)) schoolDisclosure.open = false;
  });
  // A sentinel at the top of the page: once it scrolls away, the header lifts off the content.
  const mainNav = document.getElementById('main-nav');
  const navSentinel = document.createElement('div');
  navSentinel.setAttribute('aria-hidden', 'true');
  mainNav?.before(navSentinel);
  if (mainNav) new IntersectionObserver(([entry]) => mainNav.classList.toggle('is-scrolled', !entry.isIntersecting)).observe(navSentinel);

  const desktop = window.matchMedia('(min-width: 820px)');
  desktop.addEventListener('change', () => {
    setMobileMenu(false);
    if (schoolDisclosure) schoolDisclosure.open = false;
  });
</script>

<style>
  .nav-container { width: min(100%, 80rem); margin-inline: auto; padding-inline: clamp(1rem, 3vw, 2rem); }
  .contact-strip { display: none; flex-shrink: 0; background: var(--color-forest-dark); color: white; font-size: .875rem; }
  .contact-strip-inner { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .contact-strip-links { display: flex; align-items: center; gap: 1.5rem; }
  .contact-strip a { display: inline-flex; align-items: center; gap: .5rem; min-height: 40px; }
  .contact-strip a:hover { color: var(--color-gold); }
  .contact-strip-inner > span { color: #d4dfd7; }
  @media (min-width: 768px) { .contact-strip { display: block; } .nav-actions .nav-phone { display: none; } }
  #main-nav { position: sticky; top: 0; z-index: var(--z-sticky); background: white; border-bottom: 1px solid var(--color-line); transition: box-shadow var(--duration-slow) var(--ease-out), border-color var(--duration-slow) var(--ease-out); }
  #main-nav.is-scrolled { border-bottom-color: transparent; box-shadow: 0 6px 8px -6px rgb(30 61 41 / 18%); }
  .nav-row { display: flex; flex-wrap: wrap; padding-block: .5rem; justify-content: space-between; align-items: center; gap: 1rem; min-height: 5.5rem; }
  .school-brand { display: flex; max-width: 100%; align-items: center; gap: .75rem; flex-shrink: 0; color: var(--color-forest-dark); }
  .school-brand img { width: 3.75rem; height: 3.75rem; object-fit: contain; }
  .school-brand strong { display: block; font-size: 1.0625rem; font-weight: 600; }
  .school-brand > span > span { font-size: .875rem; }
  .desktop-navigation { display: none; align-items: center; gap: .25rem; }
  .nav-link, summary { white-space: nowrap; display: inline-flex; align-items: center; line-height: 1.5; padding: .75rem; font-size: .9375rem; font-weight: 500; min-height: 48px; border-radius: var(--radius-control); }
  /* Header links: an underline that grows from the left, instead of a grey block. */
  .nav-label { position: relative; }
  .nav-label::after { content: ''; position: absolute; left: 0; right: 0; bottom: -.25rem; height: 2px; background: currentColor; transform: scaleX(0); transform-origin: left; transition: transform var(--duration-slow) var(--ease-out); }
  .nav-link:hover, summary:hover, details[open] > summary { color: var(--color-forest-green); }
  .nav-link:hover .nav-label::after, summary:hover .nav-label::after, details[open] > summary .nav-label::after, .nav-link[aria-current="page"] .nav-label::after { transform: scaleX(1); }
  .nav-link[aria-current="page"] { text-decoration: none; }
  .school-dropdown a:hover { background: var(--color-surface); color: var(--color-forest-green); }
  [aria-current="page"] { color: var(--color-forest-green); text-decoration: underline; text-underline-offset: .35em; }
  .nav-actions { display: flex; margin-inline-start: auto; align-items: center; gap: .5rem; flex-shrink: 0; }
  .nav-phone { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; min-height: 48px; padding: .75rem; background: var(--color-surface); color: var(--color-forest-dark); border-radius: var(--radius-control); font-size: .9375rem; font-weight: 600; white-space: nowrap; }
  .nav-phone:hover { background: var(--color-line); }
  .phone-number { display: none; }
  .nav-visit { display: none; font-size: .875rem; white-space: nowrap; padding-inline: 1rem; }
  .school-disclosure { position: relative; }
  summary { list-style: none; display: flex; align-items: center; gap: .375rem; cursor: pointer; }
  summary::-webkit-details-marker { display: none; }
  summary svg { transition: transform var(--duration-fast) var(--ease-out); }
  details[open] summary svg { transform: rotate(180deg); }
  .school-dropdown { position: absolute; top: calc(100% + 1rem); left: 0; width: 30rem; padding: 1.5rem; display: grid; grid-template-columns: 1fr 1.2fr; gap: 1.5rem; background: white; border: 1px solid var(--color-line); border-radius: var(--radius-media); box-shadow: 0 8px 8px -8px rgb(30 61 41 / 16%); z-index: var(--z-dropdown); transform-origin: top left; }
  details[open] .school-dropdown { animation: dropdown-open var(--duration-slow) var(--ease-out); }
  details[open] .school-dropdown a { animation: item-rise var(--duration-slow) var(--ease-out) both; }
  details[open] .school-dropdown > div:nth-child(2) a:nth-child(1) { animation-delay: 40ms; }
  details[open] .school-dropdown > div:nth-child(2) a:nth-child(2) { animation-delay: 80ms; }
  details[open] .school-dropdown > div:nth-child(2) a:nth-child(3) { animation-delay: 120ms; }
  details[open] .school-dropdown .dropdown-film { animation-delay: 160ms; }
  @keyframes dropdown-open { from { opacity: 0; transform: translateY(-.375rem) scale(.98); } }
  @keyframes item-rise { from { opacity: 0; transform: translateY(.25rem); } }
  .school-dropdown p { color: var(--color-text-muted); font-size: .875rem; padding: 0 .625rem .5rem; }
  .school-dropdown a { display: flex; flex-direction: column; gap: .125rem; min-height: 48px; padding: .625rem; border-radius: var(--radius-control); font-weight: 500; transition: background-color var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out); }
  .school-dropdown a > span { display: inline-flex; align-items: center; gap: .375rem; }
  .school-dropdown a > span > svg { opacity: 0; transform: translateX(-.375rem); transition: opacity var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out); }
  .school-dropdown a:hover > span > svg, .school-dropdown a:focus-visible > span > svg { opacity: 1; transform: none; }

  /* Programmes as a growth line: one stem, and a node that grows with each age group. */
  .growth-line { position: relative; padding-left: 1.25rem; }
  .growth-line::before { content: ''; position: absolute; left: .4375rem; top: 1.375rem; bottom: 1.375rem; width: 1px; background: var(--color-line); }
  .growth-line a { position: relative; }
  .growth-line a::before { content: ''; position: absolute; left: -.8125rem; top: 1.125rem; width: var(--node, .375rem); height: var(--node, .375rem); border-radius: 50%; background: var(--color-forest-light); transform: translate(-50%, -50%); transition: transform var(--duration-fast) var(--ease-out), background-color var(--duration-fast) var(--ease-out); }
  .growth-line a:nth-child(2) { --node: .5rem; }
  .school-dropdown a[aria-current="page"], .mobile-school-links a[aria-current="page"] { text-decoration: none; }
  .school-dropdown a[aria-current="page"] > span, .mobile-school-links a[aria-current="page"] > span:first-child { text-decoration: underline; text-underline-offset: .35em; }
  .growth-line a:nth-child(3) { --node: .6875rem; }
  .growth-line a:hover::before, .growth-line a[aria-current="page"]::before { background: var(--color-forest-green); transform: translate(-50%, -50%) scale(1.3); }

  .school-dropdown .dropdown-film { display: none; }
  @media (min-width: 1200px) {
    .school-dropdown { width: 44rem; grid-template-columns: 1fr 1.2fr 1.1fr; }
    .school-dropdown .dropdown-film { display: flex; justify-content: start; gap: .75rem; padding: 0; color: var(--color-forest-dark); }
    .school-dropdown .dropdown-film:hover { background: transparent; }
    .dropdown-film-image { position: relative; display: block; overflow: hidden; border-radius: var(--radius-control); }
    .dropdown-film-image img { display: block; width: 100%; aspect-ratio: 4/3; object-fit: cover; transition: transform var(--duration-slow) var(--ease-out); }
    .dropdown-film:hover img { transform: scale(1.04); }
    .dropdown-film-play { position: absolute; left: .75rem; bottom: .75rem; display: grid; place-items: center; width: 2.25rem; height: 2.25rem; padding-left: 2px; border-radius: 50%; background: var(--color-gold); color: var(--color-forest-dark); }
    .dropdown-film > span:last-child { font-weight: 600; text-decoration: underline; text-decoration-color: var(--color-line); text-underline-offset: .3em; transition: text-decoration-color var(--duration-fast) var(--ease-out); }
    .dropdown-film:hover > span:last-child { text-decoration-color: currentColor; }
  }
  .school-dropdown small { color: var(--color-text-muted); font-size: .875rem; font-weight: 400; }
  #mobile-menu-btn { display: flex; align-items: center; justify-content: center; gap: .5rem; min-width: 48px; min-height: 48px; padding: .625rem; border: 1px solid var(--color-line); border-radius: var(--radius-control); color: var(--color-forest-dark); font-size: .875rem; cursor: pointer; }
  #mobile-menu-btn:hover { background: var(--color-surface); }
  #mobile-menu { border-top: 1px solid var(--color-line); max-height: calc(100dvh - 5.5rem); overflow-y: auto; }
  .mobile-links { padding-block: .75rem 1.25rem; }
  .mobile-links a { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: .75rem; min-height: 48px; border-radius: var(--radius-control); }
  .mobile-links a:hover { background: var(--color-surface); color: var(--color-forest-dark); }
  .mobile-links small { color: var(--color-text-muted); font-size: .875rem; }
  .mobile-school-links { padding-bottom: .5rem; margin-bottom: .5rem; border-bottom: 1px solid var(--color-line); }
  .mobile-links .btn-primary { justify-content: center; margin-top: .75rem; }
  .mobile-links .mobile-phone { justify-content: center; font-size: .875rem; }
  .nav-link.nav-camps, .mobile-links .nav-camps { display: flex; align-items: center; justify-content: flex-start; gap: .375rem; color: var(--color-gold-nav); font-weight: 600; }
  .nav-camps svg { flex-shrink: 0; color: var(--color-gold); transition: transform 600ms var(--ease-out); }
  .nav-camps:hover svg { transform: rotate(90deg); }
  .nav-link.nav-camps:hover, .mobile-links .nav-camps:hover { background: transparent; color: var(--color-gold-nav); }
  .mobile-links .nav-camps:hover { text-decoration: underline; text-underline-offset: .35em; }
  .mobile-links .nav-camps[aria-current="page"] { text-decoration-thickness: 2px; }

  #mobile-menu:not([hidden]) { animation: menu-open var(--duration-slow) var(--ease-out); }
  #mobile-menu:not([hidden]) .mobile-links > * { animation: item-rise var(--duration-slow) var(--ease-out) both; }
  #mobile-menu:not([hidden]) .mobile-links > :nth-child(2) { animation-delay: 30ms; }
  #mobile-menu:not([hidden]) .mobile-links > :nth-child(3) { animation-delay: 60ms; }
  #mobile-menu:not([hidden]) .mobile-links > :nth-child(4) { animation-delay: 90ms; }
  #mobile-menu:not([hidden]) .mobile-links > :nth-child(5) { animation-delay: 120ms; }
  #mobile-menu:not([hidden]) .mobile-links > :nth-child(n + 6) { animation-delay: 150ms; }
  @keyframes menu-open { from { opacity: 0; transform: translateY(-.5rem); } }
  .mobile-links .growth-line::before { top: 1.5rem; bottom: 1.5rem; }
  .mobile-links .growth-line a::before { top: 1.5rem; }

  @media (prefers-reduced-motion: reduce) {
    #main-nav, .nav-label::after, summary svg, .nav-camps svg, .school-dropdown a, .school-dropdown a > span > svg, .growth-line a::before, .dropdown-film-image img { transition: none; }
    details[open] .school-dropdown, details[open] .school-dropdown a, #mobile-menu:not([hidden]), #mobile-menu:not([hidden]) .mobile-links > * { animation: none; }
    .nav-camps:hover svg, .dropdown-film:hover img { transform: none; }
  }
  [hidden] { display: none !important; }
  @media (min-width: 820px) { .desktop-navigation { display: flex; margin-left: auto; } .phone-number, .nav-visit { display: inline-flex; } .phone-label { display: none; } #mobile-menu-btn, #mobile-menu { display: none; } }
  @media (min-width: 820px) and (max-width: 1199px) {
    .nav-container { padding-inline: 1rem; }
    .nav-row { gap: .5rem; flex-wrap: nowrap; }
    .school-brand { gap: .5rem; }
    .school-brand img { width: 3rem; height: 3rem; }
    .school-brand strong { font-size: .9375rem; }
    .nav-link, summary { padding-inline: .5rem; font-size: .875rem; }
    .desktop-navigation { gap: 0; }
    .nav-phone { font-size: .875rem; padding-inline: .625rem; }
  }
  /* "Holidays & Wednesdays" is the longest link; the narrowest desktop widths drop its icon to stay on one line. */
  @media (min-width: 820px) and (max-width: 899px) { .nav-link.nav-camps svg { display: none; } }
  @media (max-width: 380px) {
    .school-brand strong { max-width: 6rem; }
    .nav-phone { padding-inline: .5rem; }
    .nav-actions { gap: .375rem; }
  }
  @media (max-width: 420px) {
    .school-brand { gap: .5rem; }
    .school-brand img { width: 2.75rem; height: 2.75rem; }
    .school-brand strong { font-size: .875rem; }
    .school-brand > span > span { font-size: .8125rem; }
    #mobile-menu-btn span { display: none; }
    .nav-row { gap: .75rem; }
  }
</style>
