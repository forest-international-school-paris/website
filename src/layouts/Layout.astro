---
import '../styles/global.css';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import Popup from '../components/Popup.astro';
import Analytics from '../components/Analytics.astro';
import { openHouse, eventDate, eventTime } from '../lib/open-house';
import { instagramUrl, phoneE164, school, whatsappHref } from '../lib/site';

interface Props {
  title: string;
  titleBrand?: string;
  description?: string;
  image?: string;
  showPopup?: boolean;
  lang?: 'en' | 'fr';
  // hreflang alternates for pages that exist in both languages, e.g.
  // [{ hreflang: 'en', href: '/admissions/' }, { hreflang: 'fr', href: '/fr/admissions/' }]
  alternates?: { hreflang: string; href: string }[];
  // utility pages (surveys, redirect targets) that must stay out of search
  noindex?: boolean;
}

const {
  title,
  titleBrand = "Forest International School Paris",
  description = "Forest International School Paris - An International school nurturing young minds through nature-based learning",
  image = "/images/campus.jpg",
  showPopup = true,
  lang = 'en',
  alternates = [],
  noindex = false
} = Astro.props;

const siteUrl = 'https://forest-international.com';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const ogImageUrl = new URL(image, siteUrl).href;
const fullTitle = `${title} | ${titleBrand}`;
const ogLocale = lang === 'fr' ? 'fr_FR' : 'en_GB';

// Popup configuration
const popupConfig = {
  enabled: true,
  expiresDate: openHouse.start.slice(0, 10),
  title: "Open House",
  subtitle: "Come and visit our forest campus",
  date: eventDate,
  time: eventTime,
  message: "Join us for a morning at Forest International School. Tour our forest campus, meet our teachers, and discover how nature-based learning nurtures every child.",
  buttonText: "Book Your Place",
  buttonLink: openHouse.registrationUrl,
  secondaryButtonText: "Learn More",
  secondaryButtonLink: "/admissions/",
  badge: "Open House",
  image: "/images/campus.jpg"
};

const isExpired = popupConfig.expiresDate
  ? new Date() > new Date(popupConfig.expiresDate + "T23:59:59")
  : false;
const popup = { ...popupConfig, enabled: popupConfig.enabled && !isExpired };
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {alternates.map((alt) => (
      // hreflang must reference the canonical (trailing-slash) URL form
      <link rel="alternate" hreflang={alt.hreflang} href={new URL(alt.href.endsWith('/') ? alt.href : `${alt.href}/`, siteUrl).href} />
    ))}
    <link rel="icon" type="image/png" href="/images/logo-header.png" />
    <link rel="apple-touch-icon" href="/images/logo-header.png" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Forest International School Paris" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={ogLocale} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <title>{fullTitle}</title>

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "EducationalOrganization",
      "name": school.name,
      "alternateName": "Forest International",
      "url": siteUrl,
      "logo": `${siteUrl}/images/logo-header.png`,
      "image": `${siteUrl}/images/campus.jpg`,
      "description": "An International school nurturing young minds through nature-based learning in Paris west.",
      "telephone": phoneE164,
      "email": school.email,
      "foundingDate": "2003",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "28 Rue de Tour d'Echelle",
        "addressLocality": "Mareil-Marly",
        "postalCode": "78750",
        "addressCountry": "FR"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 48.8784,
        "longitude": 2.0917
      },
      "areaServed": {
        "@type": "Place",
        "name": "Paris West, Ile-de-France"
      },
      "sameAs": [instagramUrl],
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": phoneE164,
        "contactType": "admissions",
        "email": school.email,
        "availableLanguage": ["English", "French"]
      }
    })} />

    <!-- Analytics (PostHog) -->
    <Analytics />
  </head>
  <body class="bg-[#faf8f5] text-gray-800 min-h-screen flex flex-col">
    <a href="#main-content" class="skip-link">Skip to content</a>
    <Navigation />
    <main id="main-content" tabindex="-1" class="flex-grow">
      <slot />
    </main>
    <Footer />

    <!-- Popup Component -->
    {showPopup && (
      <Popup
        enabled={popup.enabled}
        title={popup.title}
        subtitle={popup.subtitle}
        date={popup.date}
        time={popup.time}
        message={popup.message}
        buttonText={popup.buttonText}
        buttonLink={popup.buttonLink}
        secondaryButtonText={popup.secondaryButtonText}
        secondaryButtonLink={popup.secondaryButtonLink}
        badge={popup.badge}
        image={popup.image}
        startsAt={openHouse.start}
        timeZone={openHouse.timeZone}
      />
    )}

    <!-- Floating Contact Button -->
    <div class="contact-actions fixed bottom-4 right-4 sm:bottom-6 sm:right-6 flex flex-col gap-3">
      <!-- WhatsApp Button -->
      <a
        href={whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        class="group w-14 h-14 bg-[#2d5a3d] hover:bg-[#1e3d29] rounded-full flex items-center justify-center"
        aria-label="Chat on WhatsApp"
      >
        <svg class="w-7 h-7 text-white" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
      </a>

    </div>
  </body>
</html>
