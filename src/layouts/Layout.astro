---
import '../styles/global.css';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import Popup from '../components/Popup.astro';
import Analytics from '../components/Analytics.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  showPopup?: boolean;
  lang?: 'en' | 'fr';
  // hreflang alternates for pages that exist in both languages, e.g.
  // [{ hreflang: 'en', href: '/admissions/' }, { hreflang: 'fr', href: '/fr/admissions/' }]
  alternates?: { hreflang: string; href: string }[];
  // utility pages (surveys, redirect targets) that must stay out of search
  noindex?: boolean;
}

const {
  title,
  description = "Forest International School Paris - An International school nurturing young minds through nature-based learning",
  image = "/images/campus.jpg",
  showPopup = true,
  lang = 'en',
  alternates = [],
  noindex = false
} = Astro.props;

const siteUrl = 'https://forest-international.com';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const ogImageUrl = new URL(image, siteUrl).href;
const fullTitle = `${title} | Forest International School Paris`;
const ogLocale = lang === 'fr' ? 'fr_FR' : 'en_GB';

// Popup configuration
const popupConfig = {
  enabled: true,
  expiresDate: "2027-12-31",
  title: "Wednesday MasterClasses",
  subtitle: "Two tailored programmes, one for every child",
  date: "Every Wednesday",
  time: "8:00 AM - 6:00 PM",
  message: "Expert-led, hands-on enrichment sessions. Choose the track that fits your child, or combine both.",
  programs: [
    {
      icon: "🇬🇧",
      name: "English Enrichment",
      audience: "For French speakers",
      description: "Empower children to become confident English speakers and writers through interactive, immersive learning experiences that make language acquisition natural, enjoyable, and meaningful."
    },
    {
      icon: "🇫🇷",
      name: "L'Atelier du Français",
      audience: "For non-francophones",
      description: "Enable expatriate and international children to acquire French naturally through a structured programme of immersive, experiential, and interactive workshops."
    }
  ],
  buttonText: "Register Now",
  buttonLink: "https://docs.google.com/forms/d/e/1FAIpQLSenMtdBQPV1w-LJjl6SLFV07K6GGkGf-lx760_lxrqfrFMrEA/viewform",
  secondaryButtonText: "Learn More",
  secondaryButtonLink: "/admissions/",
  badge: "MasterClasses",
  image: "/images/campus.jpg"
};

const isExpired = popupConfig.expiresDate
  ? new Date() > new Date(popupConfig.expiresDate + "T23:59:59")
  : false;
const popup = { ...popupConfig, enabled: popupConfig.enabled && !isExpired };
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {alternates.map((alt) => (
      // hreflang must reference the canonical (trailing-slash) URL form
      <link rel="alternate" hreflang={alt.hreflang} href={new URL(alt.href.endsWith('/') ? alt.href : `${alt.href}/`, siteUrl).href} />
    ))}
    <link rel="icon" type="image/png" href="/images/logo-header.png" />
    <link rel="apple-touch-icon" href="/images/logo-header.png" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Forest International School Paris" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={ogLocale} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet">
    <title>{fullTitle}</title>

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "EducationalOrganization",
      "name": "Forest International School Paris",
      "alternateName": "Forest International",
      "url": siteUrl,
      "logo": `${siteUrl}/images/logo-header.png`,
      "image": `${siteUrl}/images/campus.jpg`,
      "description": "An International school nurturing young minds through nature-based learning in Paris west.",
      "telephone": "+33632725145",
      "email": "discover@forestinternationalschool.com",
      "foundingDate": "2003",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "28 Rue de Tour d'Echelle",
        "addressLocality": "Mareil-Marly",
        "postalCode": "78750",
        "addressCountry": "FR"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 48.8784,
        "longitude": 2.0917
      },
      "areaServed": {
        "@type": "Place",
        "name": "Paris West, Ile-de-France"
      },
      "sameAs": ["https://www.instagram.com/the_forestinternational_school/"],
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+33632725145",
        "contactType": "admissions",
        "email": "discover@forestinternationalschool.com",
        "availableLanguage": ["English", "French"]
      }
    })} />

    <!-- Analytics (PostHog) -->
    <Analytics />
  </head>
  <body class="bg-[#faf8f5] text-gray-800 min-h-screen flex flex-col">
    <Navigation />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />

    <!-- Popup Component -->
    {showPopup && (
      <Popup
        enabled={popup.enabled}
        title={popup.title}
        subtitle={popup.subtitle}
        date={popup.date}
        time={popup.time}
        message={popup.message}
        buttonText={popup.buttonText}
        buttonLink={popup.buttonLink}
        secondaryButtonText={popup.secondaryButtonText}
        secondaryButtonLink={popup.secondaryButtonLink}
        badge={popup.badge}
        image={popup.image}
        programs={popup.programs}
      />
    )}

    <!-- Floating Contact Button -->
    <div class="fixed bottom-6 right-6 z-50 flex flex-col gap-3">
      <!-- WhatsApp Button -->
      <a
        href="https://wa.me/33632725145"
        target="_blank"
        rel="noopener noreferrer"
        class="group w-14 h-14 bg-[#25D366] hover:bg-[#1da851] rounded-full flex items-center justify-center shadow-lg hover:shadow-xl transition-all hover:scale-110"
        aria-label="Chat on WhatsApp"
      >
        <svg class="w-7 h-7 text-white" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
      </a>

      <!-- Email Button -->
      <a
        href="mailto:discover@forestinternationalschool.com"
        class="group w-14 h-14 bg-[#c9a962] hover:bg-[#b8984f] rounded-full flex items-center justify-center shadow-lg hover:shadow-xl transition-all hover:scale-110"
        aria-label="Email us"
      >
        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
        </svg>
      </a>
    </div>
  </body>
</html>
